# App
LONGTAIL_ENV=development
# Direct is the local/advanced default. The maintained Compose file overrides this to compose.
LONGTAIL_DEPLOYMENT_MODE=direct
# Public-demo mode is default-off and accepted only for the exact reviewed demo Compose identity.
DEMO_MODE=false
# Exact public-demo deployments may review these fixed-window controls. Leave
# them commented for normal/local installs; nonempty values require DEMO_MODE=true.
# LONGTAIL_PUBLIC_DEMO_PERIMETER_WINDOW_SECONDS=60
# LONGTAIL_PUBLIC_DEMO_GLOBAL_REQUEST_LIMIT=2400
# LONGTAIL_PUBLIC_DEMO_CLIENT_REQUEST_LIMIT=600
# LONGTAIL_PUBLIC_DEMO_MUTATION_LIMIT=120
# LONGTAIL_PUBLIC_DEMO_SEARCH_LIMIT=60
# LONGTAIL_PUBLIC_DEMO_MAX_BODY_BYTES=131072
LONGTAIL_PUBLIC_URL=http://localhost:8001
# Production HTTP is rejected unless this explicitly unsafe development-only override is true.
LONGTAIL_UNSAFE_ALLOW_INSECURE_PUBLIC_URL=false
# Production trace/debug logging is rejected unless this narrowly scoped override is true.
LONGTAIL_UNSAFE_ALLOW_DEBUG_LOGGING=false
HOST=0.0.0.0
PORT=8001
# Optional immutable deployment identity. Release automation supplies exact lowercase hexadecimal values; local development leaves both blank.
LONGTAIL_RELEASE_COMMIT=
LONGTAIL_RELEASE_ARTIFACT_SHA256=
# Public legal pages use neutral bundled templates by default. Hosted services must point these at operator-approved Markdown outside the public web root.
LONGTAIL_TERMS_CONTENT_PATH=./legal/default-terms.md
LONGTAIL_PRIVACY_CONTENT_PATH=./legal/default-privacy.md
# Must contain {ref}; release commit is preferred, with v<canonicalVersion> as the fallback.
LONGTAIL_CORRESPONDING_SOURCE_URL_TEMPLATE=https://github.com/michaelyorkpa/Longtail-Forge/tree/{ref}
# Keep false for direct/local mode. For the supported Caddy path, follow docs/internet-deployment.md and list only the immediate peer IP/CIDR; never use true.
TRUST_PROXY=false

# Authentication throttling
# Internet-safe defaults: the fifth failed verification locks the client-IP and/or account bucket for 15 minutes.
LONGTAIL_AUTH_THROTTLE_ENABLED=true
# Production rejects disabled authentication throttling unless this narrowly scoped override is true.
LONGTAIL_UNSAFE_ALLOW_DISABLED_AUTH_THROTTLE=false
LONGTAIL_AUTH_THROTTLE_WINDOW_SECONDS=900
LONGTAIL_AUTH_THROTTLE_FAILURE_LIMIT=5
LONGTAIL_AUTH_THROTTLE_LOCKOUT_SECONDS=900
# Strict in-flight bounds applied before Argon2id, PBKDF2, or dummy-hash login verification.
LONGTAIL_AUTH_VERIFICATION_CONCURRENCY_LIMIT=4
LONGTAIL_AUTH_VERIFICATION_CONCURRENCY_PER_IP_LIMIT=2

# Support View
# Read-only Support View is an install-level security feature and is disabled by default.
LONGTAIL_SUPPORT_VIEW_ENABLED=false
# Support sessions expire after 15 minutes by default and may not exceed one hour.
LONGTAIL_SUPPORT_VIEW_TTL_SECONDS=900

# Data
LONGTAIL_DATA_DIR=./data

# Release identity (deployment automation supplies these; leave blank for an explicitly local unqualified run)
LONGTAIL_RELEASE_BRANCH=
LONGTAIL_RELEASE_COMMIT=
LONGTAIL_RELEASE_ARTIFACT_SHA256=

# Database
LONGTAIL_DATABASE_PROVIDER=sqlite

# SQLite
LONGTAIL_DATABASE_FILE=./data/longtail-forge.db
LONGTAIL_SQLITE_FOREIGN_KEYS=on
LONGTAIL_SQLITE_JOURNAL_MODE=wal
LONGTAIL_SQLITE_BUSY_TIMEOUT_MS=5000
LONGTAIL_SQLITE_SYNCHRONOUS=normal
LONGTAIL_SQLITE_CACHE_SIZE_KIB=65536
LONGTAIL_SQLITE_TEMP_STORE=memory
LONGTAIL_SQLITE_MMAP_SIZE_BYTES=0

# Future PostgreSQL
# DATABASE_URL=
# LONGTAIL_DATABASE_POOL_MIN=1
# LONGTAIL_DATABASE_POOL_MAX=10
# LONGTAIL_DATABASE_SSL=false

# Initial bootstrap
LONGTAIL_INITIAL_WORKSPACE_NAME=Longtail Forge Workspace
SUPER_ADMIN_USERNAME=support@longtailforge.local
SUPER_ADMIN_DISPLAY_NAME=Super Admin
# Required for a fresh installation. Put the real local secret only in the untracked .env;
# deployments inject a separate secret through the service manager or secret store.
SUPER_ADMIN_PASSWORD=

# The fat local development seed and sanitized-demo role fixtures read seven
# unique passwords from this git-ignored JSON file. The normal app runtime and
# every production/preview/customer installation ignore this path.
# LONGTAIL_SANITIZED_DEMO_ROLE_CREDENTIALS_FILE=./.local/sanitized-demo-role-credentials.json

# Sessions / cookies
LONGTAIL_SESSION_COOKIE_SECURE=false
LONGTAIL_SESSION_COOKIE_SAMESITE=Lax
LONGTAIL_SESSION_TTL_SECONDS=43200
# Production defaults to a 300-second HSTS rollout when this is unset. Set explicitly only after reviewing the rollout guidance.
# LONGTAIL_HSTS_MAX_AGE_SECONDS=300
# Production HSTS rollback to max-age=0 requires this narrowly scoped override.
LONGTAIL_UNSAFE_ALLOW_HSTS_ROLLBACK=false

# Secure notes
# LONGTAIL_SECURE_NOTES_MASTER_KEY=
# SECURE_NOTES_MASTER_KEY=
LONGTAIL_SECURE_NOTES_KEY_VERSION=v1

# File storage
LONGTAIL_STORAGE_PROVIDER=local
LONGTAIL_LOCAL_STORAGE_ROOT=./data/files
# Protected server-side destination for workspace backup archives and checksum sidecars. Never place this under public/ or ordinary Files storage.
LONGTAIL_WORKSPACE_BACKUP_ROOT=./backups/workspaces
# S3 is deferred scaffolding in this release; selecting LONGTAIL_STORAGE_PROVIDER=s3 fails startup until a provider client is wired.
# Reserved S3 settings are parsed for future provider work only; do not commit real credentials.
# LONGTAIL_S3_BUCKET=
# LONGTAIL_S3_REGION=
# LONGTAIL_S3_ENDPOINT=
# LONGTAIL_S3_ACCESS_KEY_ID=
# LONGTAIL_S3_SECRET_ACCESS_KEY=

# File scanning
# See docs/file-scanner-setup.md for OS-specific ClamAV setup.
LONGTAIL_FILE_SCANNER=none
# Production requires clamd/clamscan and healthy startup probing unless this narrowly scoped override is true.
LONGTAIL_UNSAFE_ALLOW_UNSCANNED_UPLOADS=false
# Optional live settings when LONGTAIL_FILE_SCANNER=clamd. Blank values use 127.0.0.1:3310; Unix sockets are not configured in this branch.
# LONGTAIL_CLAMD_HOST=127.0.0.1
# LONGTAIL_CLAMD_PORT=3310
# Optional live setting when LONGTAIL_FILE_SCANNER=clamscan. Leave blank to use clamscan from PATH.
# LONGTAIL_CLAMSCAN_PATH=

# Jobs / workers
LONGTAIL_WORKER_MODE=inline
LONGTAIL_WORKER_ID=default
LONGTAIL_JOB_POLL_INTERVAL_MS=5000
LONGTAIL_JOB_LOCK_TTL_SECONDS=300
LONGTAIL_JOB_COMPLETED_RETENTION_DAYS=30
LONGTAIL_JOB_DEAD_RETENTION_DAYS=90

# Logging
LONGTAIL_LOG_LEVEL=info
