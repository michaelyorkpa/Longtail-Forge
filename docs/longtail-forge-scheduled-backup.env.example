# Install as /etc/longtail-forge/scheduled-backup.env with root:root 0600.
# This host-only file contains no application secrets and is never loaded by Longtail Forge.
# The scheduled backup refuses the public demo whatever this file says.
LTF_SCHEDULED_BACKUP_ENABLED=true
# The post-backup copy hook, which receives exactly the backup each run inspected. Leave it empty to
# keep the backups on this server only.
LTF_SCHEDULED_BACKUP_COPY_HOOK=/usr/local/sbin/longtail-forge-offsite-copy
