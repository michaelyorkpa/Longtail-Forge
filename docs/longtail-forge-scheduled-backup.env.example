# Install as /etc/longtail-forge/scheduled-backup.env with root:root 0600.
# This host-only file contains no application secrets and is never loaded by Longtail Forge.
# The scheduled backup refuses the public demo whatever this file says.
LTF_SCHEDULED_BACKUP_ENABLED=true
# The post-backup copy hook, which receives exactly the backup each run inspected. Empty keeps the
# backups on this server only. Set it to /usr/local/sbin/longtail-forge-offsite-copy only once that
# hook and its configuration are installed: a hook that is named but missing refuses every run.
LTF_SCHEDULED_BACKUP_COPY_HOOK=
