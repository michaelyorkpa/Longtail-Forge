        "^scripts/test-support/(?:isolated-regression-retry|regression-bucket-orchestrator|regression-runner-scheduler)\\.mjs$",
        "^scripts/(?:lib/docs-change-routing|suggest-docs-for-changes)\\.mjs$",
        "^scripts/regressions/release/",
        "^src/core/(?:asset-version|version)\\.js$",
        "^src/routes/app-info\\.routes\\.js$"
