# Install as /etc/longtail-forge/maintenance-helper.env with root:root
# ownership and mode 0644. This file contains no secrets and must remain
# readable by the operator-group helper while never being writable by it.

# Create this dedicated host group and add only reviewed operator accounts.
LTF_MAINTENANCE_OPERATOR_GROUP=longtail-forge-maintenance

# Defaults are shown explicitly for review. Keep state, immutable page assets,
# and the installed helper in separate root-controlled trees.
LTF_MAINTENANCE_STATE_ROOT=/var/lib/longtail-forge-maintenance
LTF_MAINTENANCE_ASSET_ROOT=/usr/local/share/longtail-forge-maintenance
LTF_MAINTENANCE_HELPER_PATH=/usr/local/bin/longtail-forge-maintenance
