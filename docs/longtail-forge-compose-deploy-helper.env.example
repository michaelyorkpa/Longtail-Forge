# Install as /etc/longtail-forge/compose-deploy-helper.env with root:root
# ownership and mode 0600. This configures the constrained Compose helper only;
# it must not contain application secrets or the GHCR pull credential.

LTF_PUBLIC_URL=https://preview.example.com
LTF_IMAGE_REPOSITORY=ghcr.io/owner/longtail-forge

# The helper invokes Docker as root. Authenticate the root Docker client to
# GHCR separately with one pull-only credential scoped to this package. Keep
# that credential outside the deployment account and this file; rotate it by
# replacing the root Docker credential, proving a digest pull, then revoking
# the old value.

# Optional path to separately protected Secure Notes recovery-key material.
# LTF_SECURE_KEY_BACKUP=/offline-or-secret-store/secure-notes-key.backup

# The remaining values normally use their documented defaults. Set only
# reviewed installation-specific overrides, using one literal KEY=value line.
# LTF_COMPOSE_DIR=/opt/longtail-forge-compose
# LTF_COMPOSE_FILE=/opt/longtail-forge-compose/compose.yaml
# LTF_COMPOSE_HOST_ENV=/etc/longtail-forge/compose-host.env
# LTF_DEPLOY_ROOT=/var/lib/longtail-forge-compose-deploy
# The Compose helper uses this dedicated UID/GID 10001 directory while the
# parent retains the root-owned bare-metal backups through the observation
# period. The path is intentionally fixed by the reviewed helper.
# LTF_BACKUP_ROOT=/var/backups/longtail-forge/compose
# LTF_DEPLOY_ACCOUNT=longtail-forge-deploy
# LTF_MAINTENANCE_STATE_ROOT=/var/lib/longtail-forge-maintenance
