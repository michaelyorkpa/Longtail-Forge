# Install as /etc/longtail-forge/compose-cutover-helper.env with root:root
# ownership and mode 0600. This file contains path and identity policy only;
# keep application secrets in the existing protected application environment.

LTF_PUBLIC_URL=https://preview.example.com
LTF_IMAGE_REPOSITORY=ghcr.io/owner/longtail-forge

# The cutover reuses the current root-owned application environment as the
# container env_file. It writes Compose interpolation settings separately.
# LTF_BARE_METAL_SERVICE=longtail-forge
# LTF_BARE_METAL_ACCOUNT=longtail-forge
# LTF_BARE_METAL_GROUP=longtail-forge
# LTF_BARE_METAL_RELEASE_ROOT=/opt/longtail-forge
# LTF_BARE_METAL_DATA_ROOT=/var/lib/longtail-forge
# LTF_APPLICATION_ENV=/etc/longtail-forge/longtail-forge.env
# LTF_COMPOSE_DIR=/opt/longtail-forge-compose
# LTF_COMPOSE_FILE=/opt/longtail-forge-compose/compose.yaml
# LTF_COMPOSE_HOST_ENV=/etc/longtail-forge/compose-host.env
# LTF_COMPOSE_DATA_VOLUME=longtail-forge-data
# LTF_COMPOSE_NETWORK=longtail-forge-preview
# LTF_COMPOSE_SUBNET=172.30.17.0/24
# LTF_COMPOSE_GATEWAY=172.30.17.1
# LTF_DEPLOY_ROOT=/var/lib/longtail-forge-compose-deploy
# LTF_COMPOSE_BACKUP_ROOT=/var/backups/longtail-forge/compose
# LTF_MAINTENANCE_STATE_ROOT=/var/lib/longtail-forge-maintenance

# Optional path to separately protected Secure Notes recovery-key evidence.
# It is required by the backup/restore CLI when encrypted records exist and
# is mounted read-only for those operations. Never store its contents here.
# LTF_SECURE_KEY_BACKUP=/protected/secure-notes-key.backup
