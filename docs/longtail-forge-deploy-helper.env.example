# Install as /etc/longtail-forge/deploy-helper.env with root:root ownership and mode 0600.
# This file configures only the reviewed root-owned deployment helper. It is not
# the application environment and must never contain application secrets.

LTF_PUBLIC_URL=https://preview.example.com

# Optional: path to separately protected Secure Notes recovery-key material.
# Store the recovery material outside the application data root and keep its
# own permissions and recovery procedure restricted.
# LTF_SECURE_KEY_BACKUP=/offline-or-secret-store/secure-notes-key.backup

# The remaining helper values normally use their documented defaults. Set only
# reviewed installation-specific overrides, using one literal KEY=value line.
# LTF_APP_SERVICE=longtail-forge
# LTF_EDGE_SERVICE=caddy
# LTF_APP_ACCOUNT=longtail-forge
# LTF_APP_GROUP=longtail-forge
# LTF_APP_ROOT=/opt/longtail-forge
# LTF_DATA_ROOT=/var/lib/longtail-forge
# LTF_DEPLOY_ROOT=/var/lib/longtail-forge-deploy
# LTF_BACKUP_ROOT=/var/backups/longtail-forge
# LTF_APP_ENV=/etc/longtail-forge/longtail-forge.env
# LTF_RELEASE_ENV=/etc/longtail-forge/release.env
# LTF_DEPLOY_ACCOUNT=longtail-forge-deploy
