# Install only on the named demo host as /etc/longtail-forge/demo-data-helper.env.
# Keep root:root ownership and mode 0600. This file contains operator-only
# identity/path settings, not application secrets.

LTF_DEMO_TARGET=rt-ltf-demo
LTF_DEMO_HOSTNAME=rt-ltf-demo
LTF_DEMO_PUBLIC_URL=https://demo.longtailforge.com

LTF_APP_SERVICE=longtail-forge
# LTF_WORKER_SERVICE=longtail-forge-worker
LTF_EDGE_SERVICE=caddy
LTF_APP_ACCOUNT=longtail-forge
LTF_APP_GROUP=longtail-forge
LTF_APP_ROOT=/opt/longtail-forge
LTF_DATA_ROOT=/var/lib/longtail-forge
LTF_BACKUP_ROOT=/var/backups/longtail-forge
LTF_APP_ENV=/etc/longtail-forge/longtail-forge.env

# Optional: path only, never key material. Use when the demo database contains
# Secure Notes and the whole-instance backup requires separate recovery proof.
# LTF_SECURE_KEY_BACKUP=/offline-or-secret-store/secure-notes-key.backup
