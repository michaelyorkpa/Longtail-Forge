# Compose-only deployment selection. Copy the needed values into the protected root .env.
# Production must use the exact reviewed image-index digest from schema-2 release metadata;
# never deploy a mutable latest or unverified version/commit tag.
LONGTAIL_IMAGE=ghcr.io/owner/longtail-forge@sha256:REPLACE_WITH_REVIEWED_MANIFEST_DIGEST
LONGTAIL_ENV_FILE=.env
LONGTAIL_HOST_PORT=8001
LONGTAIL_RESTART_POLICY=unless-stopped
LONGTAIL_DNS_SERVER=127.0.0.11
LONGTAIL_BACKUP_DIR=./backups
LONGTAIL_DATA_VOLUME=longtail-forge-data
LONGTAIL_DOCKER_NETWORK=longtail-forge-preview
LONGTAIL_DOCKER_SUBNET=172.30.17.0/24
LONGTAIL_DOCKER_GATEWAY=172.30.17.1
LONGTAIL_DOCKER_TRUST_PROXY=172.30.17.1/32

# Application production posture. Replace every deployment-specific value.
LONGTAIL_ENV=production
DEMO_MODE=false
# For the exact rt-ltf-demo host only, set DEMO_MODE=true and optionally review
# these defaults. Keeping any LONGTAIL_PUBLIC_DEMO_* value with DEMO_MODE=false
# is a startup error.
# The exact public demo also requires these orchestration identities:
# LONGTAIL_DATA_VOLUME=longtail-forge-public-demo-data
# LONGTAIL_DOCKER_NETWORK=longtail-forge-public-demo-internal
# LONGTAIL_RESTART_POLICY=no
# LONGTAIL_DNS_SERVER=127.0.0.1
# Create that external network as an internal IPv4 bridge named ltf-demo0;
# the root-owned isolation helper installs and proves the ClamAV-only host
# exception plus default-deny host/forwarding policy before deployment.
# LONGTAIL_PUBLIC_DEMO_PERIMETER_WINDOW_SECONDS=60
# LONGTAIL_PUBLIC_DEMO_GLOBAL_REQUEST_LIMIT=2400
# LONGTAIL_PUBLIC_DEMO_CLIENT_REQUEST_LIMIT=600
# LONGTAIL_PUBLIC_DEMO_MUTATION_LIMIT=120
# LONGTAIL_PUBLIC_DEMO_SEARCH_LIMIT=60
# LONGTAIL_PUBLIC_DEMO_MAX_BODY_BYTES=131072
LONGTAIL_PUBLIC_URL=https://forge.example.com
LONGTAIL_SESSION_COOKIE_SECURE=true
LONGTAIL_HSTS_MAX_AGE_SECONDS=300
LONGTAIL_AUTH_THROTTLE_ENABLED=true
LONGTAIL_LOG_LEVEL=info

LONGTAIL_DATABASE_PROVIDER=sqlite
LONGTAIL_SQLITE_FOREIGN_KEYS=on
LONGTAIL_SQLITE_JOURNAL_MODE=wal
LONGTAIL_STORAGE_PROVIDER=local
LONGTAIL_WORKER_MODE=inline

# The supported preview requires a reachable healthy real scanner.
LONGTAIL_FILE_SCANNER=clamd
LONGTAIL_CLAMD_HOST=172.30.17.1
LONGTAIL_CLAMD_PORT=3310

# Required secrets. Supply real strong values only in the protected .env or service secret store.
SUPER_ADMIN_PASSWORD=REPLACE_THROUGH_SECRET_STORE
LONGTAIL_SECURE_NOTES_MASTER_KEY=REPLACE_THROUGH_SECRET_STORE
