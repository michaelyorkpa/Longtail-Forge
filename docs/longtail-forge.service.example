[Unit]
Description=Longtail Forge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=longtail-forge
Group=longtail-forge
WorkingDirectory=/opt/longtail-forge/current
EnvironmentFile=/etc/longtail-forge/longtail-forge.env
Environment=NODE_ENV=production
Environment=LONGTAIL_DATA_DIR=/var/lib/longtail-forge
Environment=LONGTAIL_DATABASE_FILE=/var/lib/longtail-forge/longtail-forge.db
Environment=LONGTAIL_LOCAL_STORAGE_ROOT=/var/lib/longtail-forge/files
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/longtail-forge
UMask=0077

[Install]
WantedBy=multi-user.target
