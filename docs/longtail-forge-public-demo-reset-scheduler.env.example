# Install as /etc/longtail-forge/public-demo-reset-scheduler.env with root:root 0600.
# This host-only file contains no application secrets and is never loaded by Longtail Forge.
LTF_PUBLIC_DEMO_RESET_ENABLED=true
LTF_PUBLIC_DEMO_RESET_HELPER=/usr/local/sbin/longtail-forge-public-demo-reset
LTF_PUBLIC_DEMO_RESET_ALERT_HELPER=/usr/local/sbin/longtail-forge-public-demo-reset-alert
LTF_PUBLIC_DEMO_RESET_LOG=/var/log/longtail-forge/public-demo-reset.jsonl
# Two records per hourly run retained for seven days.
LTF_PUBLIC_DEMO_RESET_LOG_RECORDS=336
