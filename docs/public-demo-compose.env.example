# Exact rt-ltf-demo Compose profile. Copy into separately protected host and
# application environment files; do not use this profile for local development,
# Friends-and-Family Preview, another self-hosted installation, or future SaaS.

# Root-owned Compose host environment. Replace the image owner and digest.
LONGTAIL_IMAGE=ghcr.io/owner/longtail-forge@sha256:REPLACE_WITH_REVIEWED_MANIFEST_DIGEST
LONGTAIL_ENV_FILE=/etc/longtail-forge/public-demo.env
LONGTAIL_HOST_PORT=8001
LONGTAIL_RESTART_POLICY=no
LONGTAIL_DNS_SERVER=127.0.0.1
LONGTAIL_BACKUP_DIR=/var/backups/longtail-forge/compose
LONGTAIL_DATA_VOLUME=longtail-forge-public-demo-data
LONGTAIL_DOCKER_NETWORK=longtail-forge-public-demo-internal
LONGTAIL_DOCKER_SUBNET=172.30.31.0/24
LONGTAIL_DOCKER_GATEWAY=172.30.31.1
LONGTAIL_DOCKER_TRUST_PROXY=172.30.31.1/32

# Root-owned application environment. Replace only redacted secrets.
LONGTAIL_ENV=production
LONGTAIL_DEPLOYMENT_MODE=compose
LONGTAIL_RELEASE_BRANCH=main
LONGTAIL_RELEASE_COMMIT=REPLACE_WITH_EXACT_40_CHARACTER_MAIN_SHA
DEMO_MODE=true
WORKSPACE_INSTALL_MODE=self_hosted
LONGTAIL_PUBLIC_URL=https://demo.longtailforge.com
LONGTAIL_SESSION_COOKIE_SECURE=true
LONGTAIL_HSTS_MAX_AGE_SECONDS=31536000
LONGTAIL_AUTH_THROTTLE_ENABLED=true
LONGTAIL_LOG_LEVEL=info

LONGTAIL_DATABASE_PROVIDER=sqlite
LONGTAIL_SQLITE_FOREIGN_KEYS=on
LONGTAIL_SQLITE_JOURNAL_MODE=wal
LONGTAIL_STORAGE_PROVIDER=local
LONGTAIL_WORKER_MODE=inline
LONGTAIL_SUPPORT_VIEW_ENABLED=false

# The exact demo permits only its reviewed ClamAV bridge-gateway handoff.
LONGTAIL_FILE_SCANNER=clamd
LONGTAIL_CLAMD_HOST=172.30.31.1
LONGTAIL_CLAMD_PORT=3310

# Defaults are explicit here so operator review sees the complete perimeter.
LONGTAIL_PUBLIC_DEMO_PERIMETER_WINDOW_SECONDS=60
LONGTAIL_PUBLIC_DEMO_GLOBAL_REQUEST_LIMIT=2400
LONGTAIL_PUBLIC_DEMO_CLIENT_REQUEST_LIMIT=600
LONGTAIL_PUBLIC_DEMO_MUTATION_LIMIT=120
LONGTAIL_PUBLIC_DEMO_SEARCH_LIMIT=60
LONGTAIL_PUBLIC_DEMO_MAX_BODY_BYTES=131072

# Supply strong values only through the protected file or secret store.
SUPER_ADMIN_USERNAME=role-super-admin@example.test
SUPER_ADMIN_DISPLAY_NAME=Role Fixture Super Administrator
SUPER_ADMIN_PASSWORD=REPLACE_THROUGH_SECRET_STORE
LONGTAIL_SECURE_NOTES_MASTER_KEY=REPLACE_THROUGH_SECRET_STORE

# Do not add analytics, feedback, newsletter, mailing-list, webhook, email,
# integration, S3/provider, URL-fetch, or other undeclared environment names.
# Exact demo startup rejects unreviewed LONGTAIL_* and known provider settings.
