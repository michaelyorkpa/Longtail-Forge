# Install as /etc/longtail-forge/offsite-copy.env with root:root 0600.
# This host-only file is read only by longtail-forge-offsite-copy, never by Longtail Forge. It names
# no secret: the SSH key is a separate root-only file, and the age recipient is a public key.
#
# The destination's address. Use the address the destination really has: a name that resolves
# elsewhere fails the pinned host-key check.
LTF_OFFSITE_HOST=203.0.113.10
LTF_OFFSITE_PORT=22
# The dedicated receiving account, whose only permitted command for this key is
# longtail-forge-offsite-receive.
LTF_OFFSITE_USER=ltf-offsite
# root:root 0600. Made on this server, for this purpose only.
LTF_OFFSITE_IDENTITY=/etc/longtail-forge/offsite-copy/id_ed25519
# root-owned, holding exactly the destination's host key, checked against a fingerprint obtained
# from the destination itself.
LTF_OFFSITE_KNOWN_HOSTS=/etc/longtail-forge/offsite-copy/known_hosts
# The operator's age public key, age1 and 58 more characters. Its private half never comes to this
# server. The hook refuses this placeholder, so a copy is never encrypted to a key nobody holds.
LTF_OFFSITE_RECIPIENT=age1-replace-with-the-operators-public-key
