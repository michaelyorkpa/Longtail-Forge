+-- Migration 093: adoption_sample_permissions
+-- Forward-only: do not edit this file after it has been applied.
+-- Reviewed adoption of the generated adoption-sample module (D3, 2026-10-01): install its one declared
+-- view permission and grant it by default only to super_admin and workspace_admin, as its manifest
+-- declares. No write, export or administration permission; no other grant, role or assignment changes.
+INSERT OR IGNORE INTO permissions (permission_id, permission_name, description)
+VALUES ('adoption_sample.view', 'View Adoption Sample', 'Read workspace records.');
+
+INSERT OR IGNORE INTO role_permissions (role_id, permission_id)
+SELECT role_id, 'adoption_sample.view'
+FROM roles
+WHERE role_id IN ('super_admin', 'workspace_admin');
