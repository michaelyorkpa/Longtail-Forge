#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

HELPER_ENV="${LTF_COMPOSE_HELPER_ENV:-/etc/longtail-forge/compose-deploy-helper.env}"
readonly ALLOWED_ENV_KEYS='^(LTF_BACKUP_ROOT|LTF_COMPOSE_DIR|LTF_COMPOSE_FILE|LTF_COMPOSE_HOST_ENV|LTF_DEMO_ROLE_CREDENTIALS|LTF_DEPLOY_ACCOUNT|LTF_DEPLOY_ROOT|LTF_IMAGE_REPOSITORY|LTF_MAINTENANCE_STATE_ROOT|LTF_PUBLIC_DEMO_ISOLATION_HELPER|LTF_PUBLIC_URL|LTF_SECURE_KEY_BACKUP)$'
readonly DEMO_TARGET='rt-ltf-demo'
readonly DEMO_ORIGIN='https://demo.longtailforge.com'
readonly OPERATOR_HOLD='/etc/longtail-forge/public-demo-hold'
readonly DEMO_DATA_VOLUME='longtail-forge-public-demo-data'
readonly DEMO_NETWORK='longtail-forge-public-demo-internal'
readonly REQUEST_LIMIT=15
# Deadlines on the stop that quiesces the demo and on the queries that prove it, so that a stalled
# Docker API cannot hold the lock and the curtain. A command that reaches its deadline has proved nothing.
readonly STOP_LIMIT=45
readonly QUERY_LIMIT=15

# The exact public-demo profile, as `docker compose config --format json` resolves it. The boot and
# the reset carry this program byte for byte, and the helper harness compares the two copies. Only
# the listed service keys may appear, so a secret, config, inherited, or device mount, an added
# capability, or a shared namespace is refused by its key. Each mount must equal its expected form
# exactly, so a volume subpath or a bind option is refused too.
readonly EXACT_PROFILE_PROGRAM='
  def declared_key: test("^(DEMO_MODE|HOST|PORT|TRUST_PROXY|WORKSPACE_INSTALL_MODE|WORKSPACE_TYPE_LIMIT|SUPER_ADMIN_(DISPLAY_NAME|PASSWORD|USERNAME)|LONGTAIL_(AUTH_[A-Z0-9_]+|CLAMD_HOST|CLAMD_PORT|DATA_DIR|DATABASE_FILE|DATABASE_PROVIDER|DEPLOYMENT_MODE|ENV|FILE_SCANNER|HSTS_MAX_AGE_SECONDS|JOB_[A-Z0-9_]+|LOCAL_STORAGE_ROOT|LOG_LEVEL|PUBLIC_URL|RELEASE_[A-Z0-9_]+|PUBLIC_DEMO_(CLIENT_REQUEST_LIMIT|GLOBAL_REQUEST_LIMIT|MAX_BODY_BYTES|MUTATION_LIMIT|PERIMETER_WINDOW_SECONDS|SEARCH_LIMIT)|SECURE_NOTES_KEY_VERSION|SECURE_NOTES_MASTER_KEY|SESSION_[A-Z0-9_]+|SQLITE_[A-Z0-9_]+|STORAGE_PROVIDER|SUPPORT_VIEW_ENABLED|SUPPORT_VIEW_TTL_SECONDS|WORKER_[A-Z0-9_]+|WORKSPACE_BACKUP_ROOT))$");
  def plain_mount:
    (if .volume == {} then del(.volume) else . end)
    | (if (.bind | type) == "object" and ((.bind | keys) - ["create_host_path"]) == [] then del(.bind) else . end);
  . as $root
  | (.services | keys) == ["longtail-forge"]
  and (.services["longtail-forge"] |
    ((keys - ["cap_drop", "command", "dns", "entrypoint", "env_file", "environment", "healthcheck", "image", "init", "logging", "networks", "ports", "read_only", "restart", "security_opt", "stop_grace_period", "tmpfs", "user", "volumes"]) == [])
    and .image == $image
    and .restart == "no"
    and .command == null
    and .entrypoint == null
    and .user == "10001:10001"
    and .read_only == true
    and .cap_drop == ["ALL"]
    and .security_opt == ["no-new-privileges:true"]
    and .dns == ["127.0.0.1"]
    and .tmpfs == ["/tmp:rw,noexec,nosuid,nodev,size=512m,mode=0700,uid=10001,gid=10001"]
    and (.networks | type == "object" and length == 1 and ((.[] // {}) == {}))
    and ((.networks | keys[0]) as $key | $root.networks[$key].name == $network and $root.networks[$key].external == true)
    and ([.volumes[] | plain_mount] | sort_by(.target) as $mounts
      | ($mounts | length) == 2
      and $mounts[0] == {type: "bind", source: $backup, target: "/var/backups/longtail-forge"}
      and ($mounts[1].source | type) == "string"
      and $mounts[1] == {type: "volume", source: $mounts[1].source, target: "/var/lib/longtail-forge"}
      and $root.volumes[$mounts[1].source] == {name: $volume})
    and (.ports | length == 1 and .[0].host_ip == "127.0.0.1" and (.[0].published | tostring) == "8001" and .[0].target == 8001)
    and .logging.driver == "local" and .logging.options["max-size"] == "10m" and .logging.options["max-file"] == "7"
    and (.environment | keys | all(declared_key))
    and (.environment |
      .DEMO_MODE == "true" and .LONGTAIL_ENV == "production" and .LONGTAIL_DEPLOYMENT_MODE == "compose"
      and .LONGTAIL_PUBLIC_URL == $origin and .LONGTAIL_DATABASE_PROVIDER == "sqlite" and .LONGTAIL_STORAGE_PROVIDER == "local"
      and .LONGTAIL_FILE_SCANNER == "clamd" and (.LONGTAIL_CLAMD_HOST | test("^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"))
      and (.LONGTAIL_CLAMD_PORT | test("^[0-9]+$")) and .LONGTAIL_WORKER_MODE == "inline" and .LONGTAIL_SUPPORT_VIEW_ENABLED == "false"
      and .LONGTAIL_DATA_DIR == "/var/lib/longtail-forge" and .LONGTAIL_DATABASE_FILE == "/var/lib/longtail-forge/longtail-forge.db"
      and .LONGTAIL_LOCAL_STORAGE_ROOT == "/var/lib/longtail-forge/files"
      and .LONGTAIL_WORKSPACE_BACKUP_ROOT == "/var/backups/longtail-forge/workspaces"))
'

fail() {
  printf 'longtail-forge-public-demo-reset: %s\n' "$*" >&2
  exit 1
}

lock_contended() {
  printf 'longtail-forge-public-demo-reset: %s\n' "$*" >&2
  exit 75
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "required command is unavailable: $1"
}

require_safe_absolute_path() {
  local target="$1" label="$2"
  [[ "$target" =~ ^/[A-Za-z0-9._/-]+$ ]] || fail "$label must be a safe absolute path"
  [[ "$target" != *'/../'* && "$target" != */.. && "$target" != *'//'* ]] || fail "$label contains unsafe traversal"
}

require_root_owned_private_file() {
  local target="$1" label="$2" owner mode parent parent_owner parent_mode
  test -f "$target" && test ! -L "$target" || fail "$label must be a regular non-symbolic-link file"
  owner="$(stat -c '%u' "$target")"
  mode="$(stat -c '%a' "$target")"
  test "$owner" = '0' || fail "$label must be root-owned"
  test "$mode" = '600' || fail "$label must use mode 0600"
  parent="$(dirname "$target")"
  parent_owner="$(stat -c '%u' "$parent")"
  parent_mode="$(stat -c '%a' "$parent")"
  test "$parent_owner" = '0' || fail "$label parent must be root-owned"
  test $((8#$parent_mode & 8#022)) -eq 0 || fail "$label parent must not be group- or other-writable"
}

# Checks a directory without changing it: a real directory, owned by root, and writable by no one else.
require_root_owned_directory() {
  local target="$1" label="$2" mode
  test -d "$target" && test ! -L "$target" || fail "$label must be a real directory"
  test "$(stat -c '%u' "$target")" = '0' || fail "$label must be root-owned"
  mode="$(stat -c '%a' "$target")"
  test $((8#$mode & 8#022)) -eq 0 || fail "$label must not be group- or other-writable"
}

load_helper_environment() {
  require_root_owned_private_file "$HELPER_ENV" 'compose helper environment'
  local line key
  declare -A seen=()
  while IFS= read -r line || test -n "$line"; do
    case "$line" in ''|'#'*) continue ;; esac
    key="${line%%=*}"
    [[ "$key" =~ $ALLOWED_ENV_KEYS ]] || fail "compose helper environment contains unsupported key: $key"
    test -z "${seen[$key]:-}" || fail "compose helper environment contains duplicate key: $key"
    seen[$key]=1
    export "$line"
  done < "$HELPER_ENV"
}

for command in awk curl cut date docker find flock grep head install jq mktemp mv readlink realpath rm sort stat tail timeout; do require_command "$command"; done
test "$(id -u)" = '0' || fail 'helper must run as root through the constrained sudo rule'
load_helper_environment

COMPOSE_DIR="${LTF_COMPOSE_DIR:-/opt/longtail-forge-compose}"
COMPOSE_FILE="${LTF_COMPOSE_FILE:-$COMPOSE_DIR/compose.yaml}"
COMPOSE_HOST_ENV="${LTF_COMPOSE_HOST_ENV:-/etc/longtail-forge/compose-host.env}"
DEPLOY_ROOT="${LTF_DEPLOY_ROOT:-/var/lib/longtail-forge-compose-deploy}"
STATE_ROOT="$DEPLOY_ROOT/state"
RELEASE_ROOT="$DEPLOY_ROOT/releases"
OPERATION_ROOT="$DEPLOY_ROOT/demo-reset-operations"
RETENTION_ROOT="$DEPLOY_ROOT/demo-retention-operations"
OPERATION_LOCK="$DEPLOY_ROOT/compose-operation.lock"
BACKUP_ROOT="${LTF_BACKUP_ROOT:-/var/backups/longtail-forge/compose}"
BACKUP_CONTAINER_ROOT='/var/backups/longtail-forge'
MAINTENANCE_STATE_ROOT="${LTF_MAINTENANCE_STATE_ROOT:-/var/lib/longtail-forge-maintenance}"
DEPLOYMENT_MARKER="$MAINTENANCE_STATE_ROOT/deployment/maintenance.on"
PUBLIC_URL="${LTF_PUBLIC_URL:-}"
ROLE_CREDENTIALS="${LTF_DEMO_ROLE_CREDENTIALS:-/etc/longtail-forge/demo-role-credentials.json}"
SECURE_KEY_BACKUP="${LTF_SECURE_KEY_BACKUP:-}"
PUBLIC_DEMO_ISOLATION_HELPER="${LTF_PUBLIC_DEMO_ISOLATION_HELPER:-/usr/local/sbin/longtail-forge-public-demo-isolation}"
CURRENT_STATE="$STATE_ROOT/current.json"

for pair in \
  "$COMPOSE_DIR:compose directory" \
  "$COMPOSE_FILE:compose file" \
  "$COMPOSE_HOST_ENV:compose host environment" \
  "$DEPLOY_ROOT:deployment root" \
  "$BACKUP_ROOT:backup root" \
  "$MAINTENANCE_STATE_ROOT:maintenance state root" \
  "$PUBLIC_DEMO_ISOLATION_HELPER:public-demo isolation helper" \
  "$ROLE_CREDENTIALS:public-demo role credentials"; do
  require_safe_absolute_path "${pair%%:*}" "${pair#*:}"
done
test "$PUBLIC_URL" = "$DEMO_ORIGIN" || fail 'public origin must be the exact named demo origin'
test "$BACKUP_ROOT" = '/var/backups/longtail-forge/compose' || fail 'backup root must remain the protected Compose backup directory'
test -d "$COMPOSE_DIR" && test ! -L "$COMPOSE_DIR" || fail 'compose directory must be a real directory'
test -f "$COMPOSE_FILE" && test ! -L "$COMPOSE_FILE" || fail 'compose file must be a real file'
require_root_owned_private_file "$COMPOSE_HOST_ENV" 'compose host environment'
require_root_owned_private_file "$ROLE_CREDENTIALS" 'public-demo role credentials'
test -f "$PUBLIC_DEMO_ISOLATION_HELPER" && test ! -L "$PUBLIC_DEMO_ISOLATION_HELPER" \
  && test -x "$PUBLIC_DEMO_ISOLATION_HELPER" && test "$(stat -c '%u' "$PUBLIC_DEMO_ISOLATION_HELPER")" = '0' \
  || fail 'public-demo isolation helper must be a root-owned executable regular file'
ROLE_CREDENTIALS_REAL="$(realpath -e -- "$ROLE_CREDENTIALS")"
case "$ROLE_CREDENTIALS_REAL" in
  "$DEPLOY_ROOT"/*|"$BACKUP_ROOT"/*|"$COMPOSE_DIR"/*) fail 'public-demo role credentials must remain outside deployment, backup, and Compose trees' ;;
esac
require_root_owned_private_file "$CURRENT_STATE" 'recorded current Compose state'
if test -n "$SECURE_KEY_BACKUP"; then
  require_safe_absolute_path "$SECURE_KEY_BACKUP" 'Secure Notes recovery-key backup'
  require_root_owned_private_file "$SECURE_KEY_BACKUP" 'Secure Notes recovery-key backup'
fi

# A reset prepares the roots it writes. Retention changes none of them: once it holds the lock, it
# checks that each is the directory a reset left, so a run that cannot lock, or refuses, leaves every
# root exactly as it found it.
if test "${1:-}" != 'retention'; then
  install -d -o root -g root -m 0711 "$DEPLOY_ROOT"
  install -d -o root -g root -m 0700 "$STATE_ROOT" "$RELEASE_ROOT" "$OPERATION_ROOT"
  if test ! -e "$OPERATION_LOCK"; then install -o root -g root -m 0600 /dev/null "$OPERATION_LOCK"; fi
fi
require_root_owned_private_file "$OPERATION_LOCK" 'Compose operation lock'
# The boot operation runs a fresh reset while it holds this lock, and hands it on as descriptor 9.
# Reuse descriptor 9 only when it is this exact lock file: flock on the inherited open file
# description succeeds for the holder that passed it on, and still contends with every other holder.
if test "$(readlink /proc/self/fd/9 2>/dev/null || true)" != "$(realpath -e -- "$OPERATION_LOCK")"; then
  exec 9<>"$OPERATION_LOCK"
fi
flock -n 9 || lock_contended 'another Compose deploy, rollback, backup, or public-demo reset operation holds the host lock'

MODE="${1:-}"
shift || true
# `retention plan` reports what retention would remove and changes nothing; `retention apply` is the
# supervised, uncapped removal. Each completed reset also runs a capped retention step of its own.
RETENTION_MODE=''
if test "$MODE" = 'retention'; then
  RETENTION_MODE="${1:-}"
  shift || true
fi
TARGET=''
ANCHOR_DATE=''
CONFIRM=''
REQUESTED_OPERATION_ID=''
CALLER=''
declare -A SEEN_ARGS=()
while test "$#" -gt 0; do
  case "$1" in
    --target) key=target; TARGET="${2:-}" ;;
    --anchor-date) key=anchor; ANCHOR_DATE="${2:-}" ;;
    --operation-id) key=operation; REQUESTED_OPERATION_ID="${2:-}" ;;
    --caller) key=caller; CALLER="${2:-}" ;;
    --confirm) key=confirm; CONFIRM="${2:-}" ;;
    *) fail "unknown argument: $1" ;;
  esac
  test -z "${SEEN_ARGS[$key]:-}" || fail "argument may be supplied only once: $1"
  test -n "${2:-}" && [[ "${2:-}" != --* ]] || fail "$1 requires a value"
  SEEN_ARGS[$key]=1
  shift 2
done
test "$MODE" = 'reset' || test "$MODE" = 'retention' || fail 'command must be reset or retention'
test "$TARGET" = "$DEMO_TARGET" || fail 'target must be exactly rt-ltf-demo'
if test "$MODE" = 'retention'; then
  test "$RETENTION_MODE" = 'plan' || test "$RETENTION_MODE" = 'apply' || fail 'retention must be plan or apply'
  test -z "$ANCHOR_DATE$REQUESTED_OPERATION_ID$CALLER" || fail 'retention accepts only --target, and --confirm to apply'
  if test "$RETENTION_MODE" = 'apply'; then
    test "$CONFIRM" = 'PRUNE RT-LTF-DEMO RESET HISTORY' || fail 'exact retention confirmation is required'
  else
    test -z "$CONFIRM" || fail 'retention plan changes nothing and takes no confirmation'
  fi
else
  test "$CONFIRM" = 'RESET RT-LTF-DEMO COMPOSE DATA' || fail 'exact reset confirmation is required'
  if test "$ANCHOR_DATE" = 'today'; then ANCHOR_DATE="$(date -u +%F)"; fi
  [[ "$ANCHOR_DATE" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || fail 'anchor date must be today or YYYY-MM-DD'
  test "$(date -u -d "$ANCHOR_DATE" +%F 2>/dev/null)" = "$ANCHOR_DATE" || fail 'anchor date is not a real calendar date'
  # An operator who stopped the demo deliberately holds it stopped: a reset would start it again.
  # Retention starts nothing, so a hold does not stop it.
  if test -e "$OPERATOR_HOLD" || test -L "$OPERATOR_HOLD"; then fail 'an operator hold is in place; remove it to resume resets'; fi
fi

# A boot-delegated reset runs behind the curtain the boot raised, and the boot owns it: this reset
# never lifts it, even after restoring the prior unit, and verifies the direct runtime only, because
# the boot reports public availability on its own and an edge failure must never cause a recovery.
test -z "$CALLER" || test "$CALLER" = 'boot' || fail 'caller must be boot when it is supplied'
if test "$CALLER" = 'boot'; then
  test -f "$DEPLOYMENT_MARKER" && test ! -L "$DEPLOYMENT_MARKER" || fail "a boot-delegated reset requires the boot's curtain"
fi
# Whether a recovery that restores and verifies the prior unit may lift the curtain. Not for the
# boot's delegate, and not once this reset has started a stopped app: the unit it would serve is the
# stale one the demo was down with, so the curtain stays up until a fresh baseline passes.
LIFT_CURTAIN_ON_RECOVERY=true
if test "$CALLER" = 'boot'; then LIFT_CURTAIN_ON_RECOVERY=false; fi

if test -n "$REQUESTED_OPERATION_ID"; then
  [[ "$REQUESTED_OPERATION_ID" =~ ^[0-9]{8}T[0-9]{6}Z-(scheduled|manual|boot)-[0-9]+$ ]] \
    || fail 'provided operation identity is invalid'
  OPERATION_ID="$REQUESTED_OPERATION_ID"
elif test "$MODE" = 'retention'; then
  OPERATION_ID="$(date -u +%Y%m%dT%H%M%SZ)-retention-$$"
else
  OPERATION_ID="$(date -u +%Y%m%dT%H%M%SZ)-reset-$$"
fi
OPERATION_DIR="$OPERATION_ROOT/$OPERATION_ID"
# A supervised retention run keeps its evidence apart from the reset history it prunes. It checks
# every root it reads without changing any, and creates nothing but that evidence.
if test "$MODE" = 'retention'; then
  for pair in "$DEPLOY_ROOT:deployment root" "$STATE_ROOT:deployment state root" \
    "$RELEASE_ROOT:release root" "$OPERATION_ROOT:reset history root"; do
    require_root_owned_directory "${pair%%:*}" "${pair#*:}"
  done
  if test -e "$RETENTION_ROOT" || test -L "$RETENTION_ROOT"; then
    require_root_owned_directory "$RETENTION_ROOT" 'retention evidence root'
  else
    install -d -o root -g root -m 0700 "$RETENTION_ROOT"
  fi
  OPERATION_DIR="$RETENTION_ROOT/$OPERATION_ID"
fi
test ! -e "$OPERATION_DIR" || fail 'operation identity already exists'
install -d -o root -g root -m 0700 "$OPERATION_DIR"
SESSION_ROOT="$(mktemp -d /run/longtail-forge-public-demo-reset.XXXXXX)"
chmod 0700 "$SESSION_ROOT"

cleanup_session_material() {
  rm -f -- "$SESSION_ROOT/pre-reset.cookie" "$SESSION_ROOT/post-reset.cookie" "$SESSION_ROOT/redactions" "$SESSION_ROOT/step.err" "$SESSION_ROOT/resolved.json"
  rmdir -- "$SESSION_ROOT" 2>/dev/null || true
}
trap cleanup_session_material EXIT

# Prints each secret-named value in one environment file, parsed as Compose parses one: an optional
# `export`, a single-quoted value taken literally, a double-quoted value with its escapes, and an
# unquoted value cut at an inline comment and trimmed.
secret_values_from_env_file() {
  awk '
    {
      line = $0
      sub(/^[ \t]+/, "", line)
      if (line == "" || substr(line, 1, 1) == "#") next
      sub(/^export[ \t]+/, "", line)
      at = index(line, "=")
      if (at == 0) next
      key = substr(line, 1, at - 1)
      sub(/[ \t]+$/, "", key)
      if (key !~ /(PASSWORD|SECRET|TOKEN|KEY|CREDENTIAL)/) next
      value = substr(line, at + 1)
      sub(/^[ \t]+/, "", value)
      quote = substr(value, 1, 1)
      if (quote == "\047") {
        value = substr(value, 2)
        stop = index(value, "\047")
        if (stop > 0) value = substr(value, 1, stop - 1)
      } else if (quote == "\"") {
        out = ""
        for (i = 2; i <= length(value); i++) {
          c = substr(value, i, 1)
          if (c == "\"") break
          if (c == "\\" && i < length(value)) {
            i++
            c = substr(value, i, 1)
            if (c == "n") c = "\n"
          }
          out = out c
        }
        value = out
      } else {
        sub(/[ \t]+#.*$/, "", value)
        sub(/[ \t]+$/, "", value)
      }
      if (length(value) > 0) print value
    }' "$1"
}

# Values that must never reach step evidence. Step error output passes through this list before it
# is kept. It starts with the demo role passwords and the secret-named values of the protected
# Compose host environment. Compose itself parses the application's environment files, however they
# are quoted, so their secrets are added from the environment it resolves, before the first step.
# Incomplete collection refuses the reset.
secret_values_from_env_file "$COMPOSE_HOST_ENV" > "$SESSION_ROOT/redactions"
jq -er '.passwords | objects | [.[] | strings | select(length > 0)] | if length > 0 then .[] else error("no role password") end' \
  "$ROLE_CREDENTIALS" >> "$SESSION_ROOT/redactions" 2>/dev/null || fail 'the public-demo role passwords could not be collected'

# Copies the last 64 KiB of a step's error output into the operation evidence with every listed
# secret replaced. Each value is matched as literal text, never as a pattern.
keep_redacted_step_output() {
  local name="$1" source="$SESSION_ROOT/step.err"
  test -s "$source" || return 0
  tail -c 65536 "$source" | awk -v listfile="$SESSION_ROOT/redactions" '
    BEGIN { while ((getline line < listfile) > 0) if (length(line) >= 4) secrets[++count] = line }
    {
      text = $0
      for (i = 1; i <= count; i++) {
        out = ""
        while ((at = index(text, secrets[i])) > 0) { out = out substr(text, 1, at - 1) "[redacted]"; text = substr(text, at + length(secrets[i])) }
        text = out text
      }
      print text
    }' > "$OPERATION_DIR/step-$name.err"
}

# Records which step is starting, before it starts, so that a kill or a power loss still leaves the
# step that was running. The record holds only the step's name and time.
begin_step() {
  local name="$1" record
  record="$(jq -cn --arg step "$name" --arg startedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '{step:$step,startedAt:$startedAt}')"
  printf '%s\n' "$record" > "$OPERATION_DIR/step.json.tmp"
  install -o root -g root -m 0600 "$OPERATION_DIR/step.json.tmp" "$OPERATION_DIR/step.json"
  rm -f -- "$OPERATION_DIR/step.json.tmp"
  printf '%s\n' "$record" >> "$OPERATION_DIR/steps.jsonl"
}

# Runs one step in a subshell with its error output captured. The subshell keeps errexit in force:
# calling a function under `||` would silently disable it inside the function. A failed step leaves
# its redacted output in the evidence, and this helper's own output names only the step. The caller's
# errexit setting is restored afterwards, so recovery, which runs without errexit, can use it too.
step() {
  local name="$1" status errexit=false
  shift
  begin_step "$name"
  case "$-" in *e*) errexit=true ;; esac
  set +e
  ( set -e; "$@" ) 2> "$SESSION_ROOT/step.err"
  status=$?
  if test "$errexit" = true; then set -e; fi
  keep_redacted_step_output "$name"
  rm -f -- "$SESSION_ROOT/step.err"
  if test "$status" -ne 0; then
    printf 'longtail-forge-public-demo-reset: step %s failed; its redacted output is in the operation evidence\n' "$name" >&2
    return "$status"
  fi
}

state_value() { jq -er "$2" "$1"; }
CURRENT_RELEASE_ENV="$(state_value "$CURRENT_STATE" '.deployment.releaseEnv')"
require_safe_absolute_path "$CURRENT_RELEASE_ENV" 'recorded release environment'
case "$CURRENT_RELEASE_ENV" in "$RELEASE_ROOT"/*.env) ;; *) fail 'recorded release environment escaped the protected release root' ;; esac
require_root_owned_private_file "$CURRENT_RELEASE_ENV" 'recorded release environment'

compose() {
  docker compose --project-directory "$COMPOSE_DIR" --file "$COMPOSE_FILE" \
    --env-file "$COMPOSE_HOST_ENV" --env-file "$CURRENT_RELEASE_ENV" "$@"
}

# Compose under a deadline. timeout runs it in a process group of its own, signals that whole group
# at the deadline, and kills it five seconds later.
bounded_compose() {
  local limit="$1"
  shift
  timeout --kill-after=5 "$limit" docker compose --project-directory "$COMPOSE_DIR" --file "$COMPOSE_FILE" \
    --env-file "$COMPOSE_HOST_ENV" --env-file "$CURRENT_RELEASE_ENV" "$@"
}

# Succeeds only when a running-state query itself succeeds, within its deadline, and lists nothing. A
# query that fails or times out prints nothing too, so its empty output is never taken as a stop.
nothing_running() {
  local running
  running="$(bounded_compose "$QUERY_LIMIT" ps --status running -q "$@")" || return 1
  test -z "$running"
}

public_demo_isolation() {
  local mode="$1" container="${2:-}" scanner_host scanner_port network volume
  scanner_host="$(compose config --format json | jq -er '.services["longtail-forge"].environment.LONGTAIL_CLAMD_HOST')"
  scanner_port="$(compose config --format json | jq -er '.services["longtail-forge"].environment.LONGTAIL_CLAMD_PORT')"
  network="$(compose config --format json | jq -er '. as $root | (.services["longtail-forge"].networks | keys[0]) as $key | $root.networks[$key].name')"
  volume="$(compose config --format json | jq -er '. as $root | (.services["longtail-forge"].volumes[] | select(.target == "/var/lib/longtail-forge").source) as $key | $root.volumes[$key].name')"
  local arguments=("$mode" --network "$network" --scanner-host "$scanner_host" --scanner-port "$scanner_port" --data-volume "$volume" --backup-root "$BACKUP_ROOT")
  if test -n "$container"; then arguments+=(--container "$container"); fi
  "$PUBLIC_DEMO_ISOLATION_HELPER" "${arguments[@]}" >/dev/null
}

# A parser error can quote a secret value from the environment files, so its output is never kept.
compose config --quiet >/dev/null 2>&1 \
  || fail 'the resolved Compose configuration did not parse; its output is not kept because it can carry secrets'
compose config --format json > "$SESSION_ROOT/resolved.json" 2>/dev/null \
  || fail 'the resolved Compose configuration could not be read'
jq -r '.services[]?.environment // {} | to_entries[] | select(.key | test("PASSWORD|SECRET|TOKEN|KEY|CREDENTIAL")) | .value | strings' \
  "$SESSION_ROOT/resolved.json" >> "$SESSION_ROOT/redactions" 2>/dev/null || fail 'the secrets in the resolved Compose environment could not be collected'
# The same exact profile the boot validates, before this reset starts or recreates anything.
IMAGE_REFERENCE="$(grep -E '^LONGTAIL_IMAGE=' "$CURRENT_RELEASE_ENV" | head -n 1 | cut -d= -f2- || true)"
jq -e --arg image "$IMAGE_REFERENCE" --arg network "$DEMO_NETWORK" --arg volume "$DEMO_DATA_VOLUME" \
  --arg backup "$BACKUP_ROOT" --arg origin "$DEMO_ORIGIN" "$EXACT_PROFILE_PROGRAM" "$SESSION_ROOT/resolved.json" >/dev/null \
  || fail 'resolved Compose profile is not the exact production public demo'
# A reset enforces the reviewed isolation before it starts or recreates anything. Retention only
# checks it: a plan must change nothing, and neither mode may rebuild the firewall, under a hold or not.
if test "$MODE" = 'retention'; then
  step isolation-check public_demo_isolation check
else
  step isolation-enforce public_demo_isolation enforce
fi

mapfile -t SQLITE_SERVICES < <(compose config --services | grep -E '^longtail-forge(-worker)?$')
printf '%s\n' "${SQLITE_SERVICES[@]}" | grep -Fxq 'longtail-forge' || fail 'Compose application service is missing'
test "${#SQLITE_SERVICES[@]}" -le 2 || fail 'unexpected duplicate SQLite service topology'

assert_marker() {
  test -d "$(dirname "$DEPLOYMENT_MARKER")" && test ! -L "$(dirname "$DEPLOYMENT_MARKER")" || fail 'deployment marker parent is unsafe'
  if test -e "$DEPLOYMENT_MARKER"; then
    test -f "$DEPLOYMENT_MARKER" && test ! -L "$DEPLOYMENT_MARKER" || fail 'deployment marker substitution is unsafe'
  else
    install -o root -g root -m 0644 /dev/null "$DEPLOYMENT_MARKER"
  fi
}

clear_marker() {
  test -f "$DEPLOYMENT_MARKER" && test ! -L "$DEPLOYMENT_MARKER" || fail 'deployment marker is not a safe regular file'
  rm -f -- "$DEPLOYMENT_MARKER"
}

record_phase() {
  local phase="$1" outcome="${2:-}"
  jq -n --arg anchor "$ANCHOR_DATE" --arg operationId "$OPERATION_ID" --arg outcome "$outcome" --arg phase "$phase" \
    --arg target "$DEMO_TARGET" '{contract:"longtail-forge-public-demo-reset-v1",target:$target,operationId:$operationId,anchorDate:$anchor,phase:$phase,outcome:$outcome}' \
    > "$OPERATION_DIR/state.json.tmp"
  install -o root -g root -m 0600 "$OPERATION_DIR/state.json.tmp" "$OPERATION_DIR/state.json"
  rm -f -- "$OPERATION_DIR/state.json.tmp"
}

run_candidate() {
  local action="$1" output="$2"
  compose run --rm --no-deps --user 0:0 --cap-add CHOWN --cap-add DAC_OVERRIDE \
    --volume "$ROLE_CREDENTIALS:/run/secrets/demo-role-credentials.json:ro" \
    longtail-forge node scripts/public-demo-baseline-candidate.mjs "$action" \
    --target "$DEMO_TARGET" --anchor-date "$ANCHOR_DATE" \
    --data-root /var/lib/longtail-forge \
    --role-credentials /run/secrets/demo-role-credentials.json > "$output"
}

run_activation() {
  local action="$1" output="$2"
  shift 2
  local arguments=("$action" --target "$DEMO_TARGET" --data-root /var/lib/longtail-forge)
  if test "$action" = 'activate'; then
    arguments+=(--operation-id "$OPERATION_ID" --confirm-quiescent 'COMPOSE SQLITE USERS STOPPED')
  elif test "$action" = 'recover'; then
    arguments+=(--confirm-quiescent 'COMPOSE SQLITE USERS STOPPED')
  elif test "$action" = 'finalize' || test "$action" = 'quarantine-stale'; then
    arguments+=(--operation-id "$OPERATION_ID")
  elif test "$action" = 'prune'; then
    # The prune's mode, and its removal cap when it has one.
    arguments+=("$@")
  fi
  compose run --rm --no-deps --user 0:0 --cap-add DAC_OVERRIDE longtail-forge \
    node scripts/public-demo-baseline-activation.mjs "${arguments[@]}" > "$output"
}

# The backup and the activation that follow rely on this stop, so each service must be proved stopped
# by a successful running-state query, not by Compose's exit status or by empty output.
stop_sqlite_users() {
  bounded_compose "$STOP_LIMIT" stop "${SQLITE_SERVICES[@]}"
  local service
  for service in "${SQLITE_SERVICES[@]}"; do
    nothing_running "$service" || fail 'a Compose SQLite service was not proved stopped'
  done
}

start_sqlite_users() {
  compose up -d --no-deps --force-recreate --pull never "${SQLITE_SERVICES[@]}"
  local service container
  for service in "${SQLITE_SERVICES[@]}"; do
    container="$(compose ps -q "$service")"
    test -n "$container" || return 1
    test "$(docker inspect --format '{{.State.Running}}' "$container")" = 'true' || return 1
  done
}

backup_current_unit() {
  local output="$1" output_name container_output
  output_name="$(basename "$output")"
  test "$output" = "$BACKUP_ROOT/$output_name" || fail 'backup output escaped the protected Compose backup root'
  container_output="$BACKUP_CONTAINER_ROOT/$output_name"
  local key_args=()
  if test -n "$SECURE_KEY_BACKUP"; then key_args=(--volume "$SECURE_KEY_BACKUP:/run/secrets/secure-notes-key.backup:ro"); fi
  compose run --rm --no-deps "${key_args[@]}" longtail-forge node scripts/backup.mjs create \
    --confirm-stopped --database /var/lib/longtail-forge/longtail-forge.db \
    --files-root /var/lib/longtail-forge/files --output "$container_output" \
    ${SECURE_KEY_BACKUP:+--secure-notes-key-backup /run/secrets/secure-notes-key.backup} \
    > "$OPERATION_DIR/backup-create.json"
  compose run --rm --no-deps "${key_args[@]}" longtail-forge node scripts/backup.mjs inspect \
    --archive "$container_output" \
    ${SECURE_KEY_BACKUP:+--secure-notes-key-backup /run/secrets/secure-notes-key.backup} \
    > "$OPERATION_DIR/backup-inspect.json"
  test -f "$output" && test ! -L "$output" || fail 'protected whole-instance backup was not created'
}

wait_for_health() {
  local container deadline status
  container="$(compose ps -q longtail-forge)"
  test -n "$container" || return 1
  deadline=$((SECONDS + 90))
  while test "$SECONDS" -lt "$deadline"; do
    status="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}missing{{end}}' "$container")"
    test "$status" != 'unhealthy' || return 1
    test "$status" = 'healthy' && return 0
    sleep 2
  done
  return 1
}

verify_runtime() {
  local version commit artifact
  version="$(state_value "$CURRENT_STATE" '.version')"
  commit="$(state_value "$CURRENT_STATE" '.commitSha')"
  artifact="$(state_value "$CURRENT_STATE" '.artifact.sha256')"
  wait_for_health || return 1
  public_demo_isolation check "$(compose ps -q longtail-forge)" || return 1
  curl --fail --silent --show-error --max-time "$REQUEST_LIMIT" http://127.0.0.1:8001/healthz | jq -e '.status == "ok"' >/dev/null || return 1
  curl --fail --silent --show-error --max-time "$REQUEST_LIMIT" http://127.0.0.1:8001/readyz | jq -e '.status == "ready"' >/dev/null || return 1
  curl --fail --silent --show-error --max-time "$REQUEST_LIMIT" http://127.0.0.1:8001/api/app-info | jq -e \
    --arg version "$version" --arg commit "$commit" --arg artifact "$artifact" \
    '.canonicalVersion == $version and .sourceBranch == "main" and .commitSha == $commit and .artifactSha256 == $artifact' >/dev/null || return 1
  # The boot's delegate stops at the direct runtime: the boot reports the public edge separately.
  test "$CALLER" != 'boot' || return 0
  curl --fail --silent --show-error --max-time "$REQUEST_LIMIT" "$PUBLIC_URL/healthz" | jq -e '.status == "ok"' >/dev/null || return 1
  curl --fail --silent --show-error --max-time "$REQUEST_LIMIT" "$PUBLIC_URL/readyz" | jq -e '.status == "ready"' >/dev/null || return 1
  curl --fail --silent --show-error --max-time "$REQUEST_LIMIT" "$PUBLIC_URL/api/app-info" | jq -e \
    --arg version "$version" --arg commit "$commit" --arg artifact "$artifact" \
    '.canonicalVersion == $version and .sourceBranch == "main" and .commitSha == $commit and .artifactSha256 == $artifact' >/dev/null
}

capture_old_session() {
  local catalog username password payload status
  catalog="$(curl --fail --silent --show-error --max-time "$REQUEST_LIMIT" http://127.0.0.1:8001/api/public-demo/accounts)"
  username="$(jq -er '.accounts[] | select(.roleName == "Workspace Administrator") | .username' <<<"$catalog")"
  password="$(jq -er '.accounts[] | select(.roleName == "Workspace Administrator") | .password' <<<"$catalog")"
  payload="$(jq -cn --arg username "$username" --arg password "$password" '{username:$username,password:$password}')"
  # Only the status is kept. The response body is the shared account's profile as visitors left it,
  # and the evidence must hold no visitor-entered content.
  status="$(curl --silent --show-error --max-time "$REQUEST_LIMIT" --output /dev/null --write-out '%{http_code}' \
    --cookie-jar "$SESSION_ROOT/pre-reset.cookie" -H 'content-type: application/json' \
    --data "$payload" http://127.0.0.1:8001/api/login)"
  jq -cn --arg status "$status" '{httpStatus:$status}' > "$OPERATION_DIR/pre-reset-login.json"
  test "$status" = '200' || fail 'representative pre-reset session could not be captured'
}

verify_old_session_rejected() {
  local status
  status="$(curl --silent --show-error --max-time "$REQUEST_LIMIT" --output "$OPERATION_DIR/old-session-response.json" --write-out '%{http_code}' \
    --cookie "$SESSION_ROOT/pre-reset.cookie" http://127.0.0.1:8001/api/session)"
  test "$status" = '401' || return 1
}

verify_representative_role() {
  local catalog username password payload status csrf_token
  catalog="$(curl --fail --silent --show-error --max-time "$REQUEST_LIMIT" http://127.0.0.1:8001/api/public-demo/accounts)"
  username="$(jq -er '.accounts[] | select(.roleName == "Workspace Administrator") | .username' <<<"$catalog")"
  password="$(jq -er '.accounts[] | select(.roleName == "Workspace Administrator") | .password' <<<"$catalog")"
  payload="$(jq -cn --arg username "$username" --arg password "$password" '{username:$username,password:$password}')"
  status="$(curl --silent --show-error --max-time "$REQUEST_LIMIT" --output "$OPERATION_DIR/post-reset-login.json" --write-out '%{http_code}' \
    --cookie-jar "$SESSION_ROOT/post-reset.cookie" -H 'content-type: application/json' \
    --data "$payload" http://127.0.0.1:8001/api/login)"
  test "$status" = '200' || return 1
  csrf_token="$(curl --fail --silent --show-error --max-time "$REQUEST_LIMIT" --cookie "$SESSION_ROOT/post-reset.cookie" \
    --cookie-jar "$SESSION_ROOT/post-reset.cookie" http://127.0.0.1:8001/api/csrf-token | jq -er '.csrfToken')" || return 1
  curl --fail --silent --show-error --max-time "$REQUEST_LIMIT" --cookie "$SESSION_ROOT/post-reset.cookie" \
    'http://127.0.0.1:8001/api/tasks?limit=1' > "$OPERATION_DIR/role-read.json" || return 1
  curl --fail --silent --show-error --max-time "$REQUEST_LIMIT" --cookie "$SESSION_ROOT/post-reset.cookie" \
    http://127.0.0.1:8001/api/client-projects > "$OPERATION_DIR/client-projects.json" || return 1
  curl --fail --silent --show-error --max-time "$REQUEST_LIMIT" --cookie "$SESSION_ROOT/post-reset.cookie" \
    'http://127.0.0.1:8001/api/files/attachments?limit=1' > "$OPERATION_DIR/role-files.json" || return 1
  jq -e '.attachments | length >= 1' "$OPERATION_DIR/role-files.json" >/dev/null || return 1
  curl --fail --silent --show-error --max-time "$REQUEST_LIMIT" --cookie "$SESSION_ROOT/post-reset.cookie" \
    -H "X-CSRF-Token: $csrf_token" --request POST http://127.0.0.1:8001/api/logout \
    > "$OPERATION_DIR/logout.json" || return 1
}

app_running() {
  local container
  container="$(compose ps -q longtail-forge)"
  test -n "$container" && test "$(docker inspect --format '{{.State.Running}}' "$container")" = 'true'
}

# The protected start a reset runs when it finds the app stopped, as after a host restart. Isolation
# is already enforced; the curtain goes up, the current release starts, and its identity and
# isolation are verified. The curtain stays up until this reset's fresh baseline passes, so a reset
# that fails afterwards never serves the stale unit it started. It never pulls, upgrades, or rolls back.
start_stopped_app() {
  assert_marker
  start_sqlite_users
  verify_runtime
}

start_and_verify_runtime() {
  start_sqlite_users
  verify_runtime
}

# Retention of the reset history. Nothing reads a completed reset's retired unit or pre-reset backup
# again, and each holds the visitor-entered content of the hour before it, so only the newest
# completed resets keep them. Evidence holds no visitor-entered content and is kept for the scheduler
# log's seven days. A reset whose state is not completed, missing, or unreadable is incident
# evidence: it, its backup, its retired unit, and any failed unit are never removed here. Neither are
# other backups, the state and release records, or the scheduler log. Selection is by count, newest
# first by the operation identity's UTC timestamp.
readonly RETAINED_BACKUPS=2
readonly RETAINED_EVIDENCE=168
readonly AUTOMATIC_REMOVAL_CAP=3
readonly RESET_OPERATION_PATTERN='^[0-9]{8}T[0-9]{6}Z-(scheduled|manual|boot|reset)-[0-9]+$'
readonly EVIDENCE_TOMBSTONE_PREFIX='.pruning-'
# Helpers before this patch kept the pre-reset login's response body: the shared account's profile as
# visitors left it. A supervised apply replaces each one that a retained completed reset still holds
# with this record. That reset completed, so its capture had answered 200.
readonly LEGACY_LOGIN_RECORD='{"httpStatus":"200","legacyBodyRemoved":true}'

# Whether an entry of the reset history is a real directory whose own state proves that this
# operation completed.
completed_reset() {
  local name="$1" directory="$OPERATION_ROOT/$1"
  [[ "$name" =~ $RESET_OPERATION_PATTERN ]] || return 1
  test -d "$directory" && test ! -L "$directory" || return 1
  test -f "$directory/state.json" && test ! -L "$directory/state.json" || return 1
  jq -e --arg id "$name" --arg target "$DEMO_TARGET" \
    '.contract == "longtail-forge-public-demo-reset-v1" and .target == $target and .operationId == $id and .phase == "completed"' \
    "$directory/state.json" >/dev/null 2>&1
}

# Evidence may be removed only as a root-owned real directory holding nothing but root-owned regular
# files and directories: no link of any kind. A traversal that fails proves nothing, so its status is
# read before its silence is trusted.
removable_evidence() {
  local directory="$1" owner offending
  test -d "$directory" && test ! -L "$directory" || return 1
  owner="$(stat -c '%u' "$directory")" || return 1
  test "$owner" = '0' || return 1
  offending="$(find "$directory" -mindepth 1 \( -type l -o ! \( -type f -o -type d \) -o ! -user 0 \) -print -quit)" || return 1
  test -z "$offending"
}

# A pre-reset backup or its checksum sidecar may be removed only as a plain file with one name,
# owned by the backup root's owner, the container user that wrote it.
removable_backup_file() {
  local file="$1" owner root_owner links
  test -f "$file" && test ! -L "$file" || return 1
  owner="$(stat -c '%u' "$file")" && root_owner="$(stat -c '%u' "$BACKUP_ROOT")" && links="$(stat -c '%h' "$file")" || return 1
  test "$owner" = "$root_owner" && test "$links" = '1'
}

# Plans, and unless planning, applies retention, and records the result in retention.json. A cap,
# given for the automatic step, makes more removals than that of any kind, tombstones included,
# remove nothing. Every check runs before anything is removed, and a listing or check that fails
# refuses, so one failed check removes nothing. The retired units go first, then the backups, archive
# before sidecar, then the evidence, each through a tombstone; a supervised apply then replaces the
# legacy login records. A run never removes anything of the reset it belongs to.
retain_history() {
  local mode="$1" cap="${2:-}" name operation_id file index found status listing incident_list='none'
  local -a names=() completed=() incidents=() backup_names=() backup_operations=() backup_files=() evidence_operations=() tombstones=() legacy_logins=()
  local other=0 orphans=0 unit_selected unit_tombstones stale_selected units_removed=0 legacy_found='null'
  # The two roots retention reads must be the real directories it expects, so that listing them
  # means what it says.
  test -d "$OPERATION_ROOT" && test ! -L "$OPERATION_ROOT" && test "$(stat -c '%u' "$OPERATION_ROOT")" = '0' \
    || fail 'the reset history root is not a root-owned real directory; nothing was removed'
  test -d "$BACKUP_ROOT" && test ! -L "$BACKUP_ROOT" || fail 'the backup root is not a real directory; nothing was removed'

  # Each listing is read whole, with its status, before any of it is trusted: an incomplete listing
  # could hide a tombstone or an incident, or rank the history wrongly.
  listing="$(find "$OPERATION_ROOT" -mindepth 1 -maxdepth 1 -printf '%f\n' | LC_ALL=C sort)" \
    || fail 'the reset history could not be listed; nothing was removed'
  if test -n "$listing"; then mapfile -t names <<<"$listing"; fi
  for name in "${names[@]}"; do
    if [[ "$name" == "$EVIDENCE_TOMBSTONE_PREFIX"* ]]; then
      [[ "${name#"$EVIDENCE_TOMBSTONE_PREFIX"}" =~ $RESET_OPERATION_PATTERN ]] && removable_evidence "$OPERATION_ROOT/$name" \
        || fail 'an evidence tombstone is unexpected; nothing was removed'
      tombstones+=("$name")
    elif completed_reset "$name"; then
      completed+=("$name")
    elif [[ "$name" =~ $RESET_OPERATION_PATTERN ]]; then
      incidents+=("$name")
    else
      other=$((other + 1))
    fi
  done

  # The history, not the volume, says which resets completed. Finalizing records a retired unit as
  # completed before its reset completes, so a reset that stops after finalizing, with a curtain that
  # cannot be lifted or a host that loses power, is an incident whose unit says otherwise. The
  # in-volume prune keeps the unit of every incident named here.
  if test "${#incidents[@]}" -gt 0; then incident_list="$(IFS=,; printf '%s' "${incidents[*]}")"; fi
  run_activation prune "$OPERATION_DIR/retention-units-plan.json" --incident-operations "$incident_list" --mode plan
  unit_selected="$(jq -er '.selected | numbers' "$OPERATION_DIR/retention-units-plan.json")"
  unit_tombstones="$(jq -er '.tombstones | numbers' "$OPERATION_DIR/retention-units-plan.json")"
  # Stale-candidate copies leave the volume with the retired units, and count against the same cap. A
  # release from before that pruning reports none, and removes none.
  stale_selected="$(jq -er 'if has("staleCandidates") then .staleCandidates.selected else 0 end | numbers' "$OPERATION_DIR/retention-units-plan.json")"
  # The reset that runs this step is the newest by any honest clock. If it ranks lower, the clock or a
  # supplied identity is wrong, and retention would remove what this reset is still reporting.
  jq -e --arg id "$OPERATION_ID" '(.selectedOperations | type == "array") and all(.selectedOperations[]; . != $id)' \
    "$OPERATION_DIR/retention-units-plan.json" >/dev/null \
    || fail 'the current reset ranks among the retired units to remove; nothing was removed'
  jq -e --arg id "$OPERATION_ID" 'if has("staleCandidates") then (.staleCandidates.selectedOperations | type == "array")
      and all(.staleCandidates.selectedOperations[]; . != $id) else true end' \
    "$OPERATION_DIR/retention-units-plan.json" >/dev/null \
    || fail 'the current reset ranks among the stale-candidate copies to remove; nothing was removed'
  if test "${#completed[@]}" -gt 0; then
    listing="$(printf '%s\n' "${completed[@]}" | LC_ALL=C sort -r)" || fail 'the reset history could not be ranked; nothing was removed'
    mapfile -t completed <<<"$listing"
  fi

  for index in "${!completed[@]}"; do
    test "$index" -ge "$RETAINED_BACKUPS" || continue
    operation_id="${completed[$index]}"
    test "$operation_id" != "$OPERATION_ID" || fail 'the current reset ranks outside the retained history; nothing was removed'
    found=false
    for file in "$BACKUP_ROOT/pre-demo-reset-$operation_id.ltfbackup.tgz" "$BACKUP_ROOT/pre-demo-reset-$operation_id.ltfbackup.tgz.sha256"; do
      if test -e "$file" || test -L "$file"; then
        removable_backup_file "$file" \
          || fail 'a pre-reset backup selected for removal is not a plain file owned by the backup root owner; nothing was removed'
        backup_files+=("$file")
        found=true
      fi
    done
    if test "$found" = true; then backup_operations+=("$operation_id"); fi
    if test "$index" -ge "$RETAINED_EVIDENCE"; then
      removable_evidence "$OPERATION_ROOT/$operation_id" \
        || fail 'reset evidence selected for removal is not a root-owned directory free of links; nothing was removed'
      test ! -e "$OPERATION_ROOT/$EVIDENCE_TOMBSTONE_PREFIX$operation_id" || fail 'an evidence tombstone already exists; nothing was removed'
      evidence_operations+=("$operation_id")
    fi
  done
  # Pre-reset backups with no reset history left are reported, never removed.
  listing="$(find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -name 'pre-demo-reset-*' -printf '%f\n')" \
    || fail 'the backup root could not be listed; nothing was removed'
  if test -n "$listing"; then mapfile -t backup_names <<<"$listing"; fi
  for name in "${backup_names[@]}"; do
    operation_id="${name#pre-demo-reset-}"
    operation_id="${operation_id%.sha256}"
    operation_id="${operation_id%.ltfbackup.tgz}"
    test -d "$OPERATION_ROOT/$operation_id" || orphans=$((orphans + 1))
  done

  # A supervised run also finds the legacy login records that retained completed resets still hold.
  # Incident evidence keeps its own.
  if test "$mode" != 'automatic'; then
    for index in "${!completed[@]}"; do
      test "$index" -lt "$RETAINED_EVIDENCE" || continue
      file="$OPERATION_ROOT/${completed[$index]}/pre-reset-login.json"
      test -e "$file" || test -L "$file" || continue
      test -f "$file" && test ! -L "$file" && test "$(stat -c '%u:%h' "$file")" = '0:1' \
        && test ! -e "$file.tmp" && test ! -L "$file.tmp" \
        || fail 'a pre-reset login record is not a plain root-owned file; nothing was removed'
      # A record is legacy unless it holds only a status, or is exactly the replacement an earlier
      # apply wrote, so a replaced record is never found or rewritten again.
      if ! jq -e --argjson replacement "$LEGACY_LOGIN_RECORD" \
        '(type == "object" and keys == ["httpStatus"] and (.httpStatus | type == "string")) or . == $replacement' "$file" >/dev/null 2>&1; then
        legacy_logins+=("$file")
      fi
    done
    legacy_found="${#legacy_logins[@]}"
  fi

  status='pruned'
  if test "$mode" = 'plan'; then
    status='planned'
  elif test -n "$cap" && { test "$((unit_selected + unit_tombstones + stale_selected))" -gt "$cap" || test "${#backup_operations[@]}" -gt "$cap" \
    || test "$((${#evidence_operations[@]} + ${#tombstones[@]}))" -gt "$cap"; }; then
    status='capped'
  fi
  if test "$status" = 'pruned'; then
    local -a prune_arguments=(--incident-operations "$incident_list" --mode apply)
    if test -n "$cap"; then prune_arguments+=(--max-removals "$cap"); fi
    run_activation prune "$OPERATION_DIR/retention-units.json" "${prune_arguments[@]}"
    test "$(jq -r '.status' "$OPERATION_DIR/retention-units.json")" = 'pruned' || fail 'the retired units were not pruned'
    units_removed="$(jq -er '.removed | numbers' "$OPERATION_DIR/retention-units.json")"
    for file in "${backup_files[@]}"; do rm -f -- "$file"; done
    for name in "${tombstones[@]}"; do rm -rf -- "${OPERATION_ROOT:?}/$name"; done
    for operation_id in "${evidence_operations[@]}"; do
      mv -T -- "$OPERATION_ROOT/$operation_id" "$OPERATION_ROOT/$EVIDENCE_TOMBSTONE_PREFIX$operation_id"
      rm -rf -- "${OPERATION_ROOT:?}/$EVIDENCE_TOMBSTONE_PREFIX$operation_id"
    done
    for file in "${legacy_logins[@]}"; do
      printf '%s\n' "$LEGACY_LOGIN_RECORD" > "$file.tmp"
      mv -T -- "$file.tmp" "$file"
    done
  fi

  jq -n --arg operationId "$OPERATION_ID" --arg mode "$mode" --arg status "$status" --arg cap "$cap" \
    --argjson unitSelected "$unit_selected" --argjson unitsRemoved "$units_removed" \
    --argjson completed "${#completed[@]}" --argjson incident "${#incidents[@]}" --argjson other "$other" \
    --argjson orphans "$orphans" --argjson tombstones "${#tombstones[@]}" --argjson legacyFound "$legacy_found" \
    --argjson backupOperations "$(jq -cn '$ARGS.positional' --args "${backup_operations[@]}")" \
    --argjson evidenceOperations "$(jq -cn '$ARGS.positional' --args "${evidence_operations[@]}")" \
    --argjson retainedBackups "$RETAINED_BACKUPS" --argjson retainedEvidence "$RETAINED_EVIDENCE" \
    --slurpfile units "$OPERATION_DIR/retention-units-plan.json" '
    ($status == "pruned") as $applied
    | {contract: "longtail-forge-public-demo-retention-v1", target: "rt-ltf-demo", operationId: $operationId,
       mode: $mode, status: $status,
       policy: {units: 2, backups: $retainedBackups, evidence: $retainedEvidence, cap: (if $cap == "" then null else ($cap | tonumber) end)},
       units: {retained: $units[0].retainedOperations, selected: $unitSelected, removed: $unitsRemoved, skipped: $units[0].skipped,
         incidents: $units[0].incidents, tombstones: $units[0].tombstones,
         staleCandidates: ($units[0].staleCandidates // {selected: 0, retained: 0, incidents: 0, skipped: 0}
           | {selected, retained, incidents, skipped, operations: (.selectedOperations // [])})},
       backups: {selected: ($backupOperations | length), removed: (if $applied then ($backupOperations | length) else 0 end), operations: $backupOperations, orphans: $orphans},
       evidence: {completed: $completed, selected: ($evidenceOperations | length), removed: (if $applied then ($evidenceOperations | length) + $tombstones else 0 end),
         operations: $evidenceOperations, incident: $incident, other: $other, tombstones: $tombstones,
         legacyLogins: {found: $legacyFound, replaced: (if $applied and $legacyFound != null then $legacyFound else 0 end)}}}' \
    > "$OPERATION_DIR/retention.json"
}

if test "$MODE" = 'retention'; then
  set +e
  step "retention-$RETENTION_MODE" retain_history "$RETENTION_MODE"
  retention_status=$?
  set -e
  test "$retention_status" -eq 0 || fail "retention $RETENTION_MODE failed; its redacted output is in $OPERATION_DIR"
  jq -c '{ok: true, mode: "retention", retentionMode: .mode, operationId, status,
    units: {selected: .units.selected, removed: .units.removed, incidents: .units.incidents,
      staleCandidates: {selected: .units.staleCandidates.selected, operations: .units.staleCandidates.operations}},
    backups: {selected: .backups.selected, removed: .backups.removed, orphans: .backups.orphans},
    evidence: {selected: .evidence.selected, removed: .evidence.removed, incident: .evidence.incident, legacyLogins: .evidence.legacyLogins}}' "$OPERATION_DIR/retention.json"
  exit 0
fi

RECOVERY_ARMED=false
RECOVERY_RUNNING=false
START_ARMED=false
APP_STARTED_BY_RESET=false
# Set as soon as finalizing succeeds. From then on no recovery may run: a signal stops only the
# retention step, and the exit handler records no other phase. A curtain that then cannot be lifted
# leaves the reset recorded as finalized, not completed, so retention keeps its evidence.
RESET_COMPLETED=false
RETENTION_INTERRUPTED=false
# The automatic recovery. Each command runs as a step, so its diagnostics are redacted like every
# other step's. Each step is called on its own and its status read afterwards: under `||` or `if`,
# bash would ignore errexit inside it.
run_recovery() {
  local recovery_ready=true step_status
  record_phase 'recovering' 'reset-failed'
  assert_marker
  # Recovery replaces the database only once the services are proved stopped.
  step recovery-stop stop_sqlite_users
  step_status=$?
  test "$step_status" -eq 0 || recovery_ready=false
  if test "$recovery_ready" = true; then
    step recovery-inspect run_activation inspect "$OPERATION_DIR/recovery-inspect.json"
    step_status=$?
    if test "$step_status" -ne 0; then
      recovery_ready=false
    elif test "$(jq -r '.active // false' "$OPERATION_DIR/recovery-inspect.json" 2>/dev/null)" = true; then
      step recovery-recover run_activation recover "$OPERATION_DIR/recovery.json"
      step_status=$?
      test "$step_status" -eq 0 || recovery_ready=false
    fi
  fi
  step_status=1
  if test "$recovery_ready" = true; then
    step recovery-start-and-verify start_and_verify_runtime
    step_status=$?
  fi
  if test "$step_status" -eq 0; then
    if test "$LIFT_CURTAIN_ON_RECOVERY" = true; then
      clear_marker
      record_phase 'recovered' 'prior-unit-healthy'
      printf 'longtail-forge-public-demo-reset: reset failed; prior unit was restored and verified\n' >&2
    else
      record_phase 'recovered' 'prior-unit-healthy-curtain-retained'
      printf 'longtail-forge-public-demo-reset: reset failed; prior unit was restored and verified behind the retained maintenance curtain\n' >&2
    fi
  else
    record_phase 'unrecovered' 'maintenance-curtain-retained'
    printf 'longtail-forge-public-demo-reset: reset and automatic recovery failed; maintenance curtain and protected evidence remain\n' >&2
  fi
}

# The session material holds the redaction list, so it is removed only once recovery is over: at
# each exit below, after the recovery subshell however that ends, or by the signal trap that stands
# in for the EXIT trap while recovery runs.
recover_on_exit() {
  local status="$1"
  if test "$RESET_COMPLETED" = true; then
    cleanup_session_material
    return "$status"
  fi
  if test "$status" -ne 0 && test "$START_ARMED" = true; then
    trap - EXIT HUP INT TERM
    cleanup_session_material
    record_phase 'unrecovered' 'maintenance-curtain-retained'
    printf 'longtail-forge-public-demo-reset: the stopped app could not be started and verified; maintenance curtain and protected evidence remain\n' >&2
    exit "$status"
  fi
  # A failure after this reset started a stopped app, but before its own recovery was armed, leaves
  # that app behind the curtain it raised.
  if test "$status" -ne 0 && test "$APP_STARTED_BY_RESET" = true && test "$RECOVERY_ARMED" = false; then
    trap - EXIT HUP INT TERM
    cleanup_session_material
    record_phase 'failed' 'maintenance-curtain-retained'
    printf 'longtail-forge-public-demo-reset: reset failed after it started the stopped app; maintenance curtain and protected evidence remain\n' >&2
    exit "$status"
  fi
  if test "$status" -eq 0 || test "$RECOVERY_ARMED" != true || test "$RECOVERY_RUNNING" != false; then
    cleanup_session_material
    return "$status"
  fi
  RECOVERY_RUNNING=true
  trap - EXIT
  trap 'cleanup_session_material; exit 130' HUP INT TERM
  set +e
  # A subshell, so that a refusal inside recovery, such as an unsafe marker, still returns here.
  ( run_recovery )
  trap - HUP INT TERM
  cleanup_session_material
  exit "$status"
}
trap 'recover_on_exit $?' EXIT
trap 'exit 130' HUP INT TERM

record_phase 'preflight'
step inspect run_activation inspect "$OPERATION_DIR/initial-inspect.json"
if test "$(jq -r '.active' "$OPERATION_DIR/initial-inspect.json")" = true; then
  assert_marker
  RECOVERY_ARMED=true
  step stop-for-recovery stop_sqlite_users
  step recover-interrupted run_activation recover "$OPERATION_DIR/interrupted-recovery.json"
  step start-recovered start_sqlite_users
  step verify-recovered verify_runtime
  if test "$LIFT_CURTAIN_ON_RECOVERY" = true; then clear_marker; fi
  RECOVERY_ARMED=false
  record_phase 'recovered-interrupted' 'rerun-required'
  fail 'an interrupted reset was recovered and verified; rerun the reset deliberately'
fi

# No operation is active, so a candidate or partial build left by an earlier operation is stale:
# activation never began, or recovery would have found its marker. Move it into failed evidence.
step quarantine-stale run_activation quarantine-stale "$OPERATION_DIR/stale-candidate.json"
if ! app_running; then
  record_phase 'starting-stopped-app'
  START_ARMED=true
  step start-stopped-app start_stopped_app
  START_ARMED=false
  APP_STARTED_BY_RESET=true
  LIFT_CURTAIN_ON_RECOVERY=false
  record_phase 'started-stopped-app'
fi

step candidate-build run_candidate build "$OPERATION_DIR/candidate-build.json"
step candidate-validate run_candidate validate "$OPERATION_DIR/candidate-validate.json"
step capture-old-session capture_old_session
assert_marker
RECOVERY_ARMED=true
record_phase 'curtained'
step stop stop_sqlite_users
record_phase 'quiescent'
BACKUP="$BACKUP_ROOT/pre-demo-reset-$OPERATION_ID.ltfbackup.tgz"
step backup backup_current_unit "$BACKUP"
record_phase 'backed-up'
step activate run_activation activate "$OPERATION_DIR/activation.json"
record_phase 'activated'
step active-baseline run_candidate active "$OPERATION_DIR/active-baseline.json"
# The result this reset reports, read now, so that nothing after completion can change or lose it.
RESULT_FINGERPRINT="$(state_value "$OPERATION_DIR/active-baseline.json" '.semanticFingerprint')"
RESULT_VERSION="$(state_value "$CURRENT_STATE" '.version')"
RESULT_COMMIT="$(state_value "$CURRENT_STATE" '.commitSha')"
step start start_sqlite_users
record_phase 'started'
step verify verify_runtime
step verify-old-session-rejected verify_old_session_rejected
step verify-representative-role verify_representative_role
record_phase 'verified'
# Finalizing commits the reset: once it succeeds, the fresh baseline is the active unit, and nothing
# may restore the prior one. From here a signal only sets a flag. If finalizing fails, the exit
# handler recovers as before; once it succeeds, the reset completes and lifts its curtain, and the
# signal stops only its retention step.
trap 'RETENTION_INTERRUPTED=true' HUP INT TERM
step finalize run_activation finalize "$OPERATION_DIR/finalize.json"
RECOVERY_ARMED=false
RESET_COMPLETED=true
record_phase 'finalized'
# The boot lifts its own curtain once this reset reports success.
if test "$CALLER" != 'boot'; then clear_marker; fi
record_phase 'completed' 'baseline-healthy'

# Retention runs once the reset has completed, still under the lock: after the curtain is down, or
# behind the boot's curtain for its delegate. It is capped, and its failure never fails or rolls back
# the completed reset: the scheduler alerts on it, and a failure under the boot is retried, and
# alerted, by the next hourly reset. A signal stops it and is reported as a failed retention.
RETENTION_SUMMARY='{"status":"failed"}'
if test "$RETENTION_INTERRUPTED" = false; then
  set +e
  step retention retain_history automatic "$AUTOMATIC_REMOVAL_CAP"
  retention_status=$?
  set -e
  if test "$retention_status" -eq 0; then
    RETENTION_SUMMARY="$(jq -ce '{status, units: .units.removed, backups: .backups.removed, evidence: .evidence.removed}' "$OPERATION_DIR/retention.json" 2>/dev/null)" \
      || RETENTION_SUMMARY='{"status":"failed"}'
  fi
fi

printf '{"ok":true,"mode":"reset","target":"%s","anchorDate":"%s","operationId":"%s","semanticFingerprint":"%s","version":"%s","commitSha":"%s","backup":"%s","appStartedByReset":%s,"retention":%s}\n' \
  "$DEMO_TARGET" "$ANCHOR_DATE" "$OPERATION_ID" "$RESULT_FINGERPRINT" "$RESULT_VERSION" "$RESULT_COMMIT" \
  "$(basename "$BACKUP")" "$APP_STARTED_BY_RESET" "$RETENTION_SUMMARY"
