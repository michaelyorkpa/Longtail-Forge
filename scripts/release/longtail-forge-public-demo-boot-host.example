#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

# Protected public-demo boot.
#
# The demo keeps Docker's `restart: no`, so that nothing starts before its isolation is in place.
# This helper is its only restart owner: a root-owned unit runs it once each time Docker starts, so
# after a host boot and after a Docker restart. Under the shared lifecycle lock it checks that a start
# is safe, validates the complete resolved Compose profile, waits for its dependencies, enforces
# isolation before any container runs, starts the recorded release behind the curtain, and verifies
# it. If an hourly reset boundary passed while the demo was down, it runs a fresh reset before
# visitors are served; otherwise it lifts the curtain.
#
# The boot owns the curtain from the moment it raises it. A delegated reset never lifts it, so
# visitors are served only after the boot has verified a start and, when a boundary was missed, a
# fresh baseline. A start that fails verification is stopped again, behind the curtain.
#
# It never pulls, upgrades, or rolls back, and it never creates an empty substitute database. Each
# refusal raises its own alert class, and an edge or DNS failure never causes a reset or a rollback.
# Check output is kept as evidence only after every known secret value is replaced: the secrets in
# the environment Compose itself resolves, and the demo role passwords. A Compose parser error is
# never kept, because it can quote a secret from the environment files.

HELPER_ENV="${LTF_COMPOSE_HELPER_ENV:-/etc/longtail-forge/compose-deploy-helper.env}"
readonly ALLOWED_ENV_KEYS='^(LTF_BACKUP_ROOT|LTF_COMPOSE_DIR|LTF_COMPOSE_FILE|LTF_COMPOSE_HOST_ENV|LTF_DEMO_ROLE_CREDENTIALS|LTF_DEPLOY_ACCOUNT|LTF_DEPLOY_ROOT|LTF_IMAGE_REPOSITORY|LTF_MAINTENANCE_STATE_ROOT|LTF_PUBLIC_DEMO_ISOLATION_HELPER|LTF_PUBLIC_URL|LTF_SECURE_KEY_BACKUP)$'
readonly DEMO_TARGET='rt-ltf-demo'
readonly DEMO_ORIGIN='https://demo.longtailforge.com'
readonly DEMO_DATA_VOLUME='longtail-forge-public-demo-data'
readonly DEMO_NETWORK='longtail-forge-public-demo-internal'
readonly DEMO_BRIDGE='ltf-demo0'
readonly OPERATOR_HOLD='/etc/longtail-forge/public-demo-hold'
readonly RESET_HELPER='/usr/local/sbin/longtail-forge-public-demo-reset'
readonly ALERT_HELPER='/usr/local/sbin/longtail-forge-public-demo-reset-alert'
readonly RESET_CONFIRMATION='RESET RT-LTF-DEMO COMPOSE DATA'
# Bounds, in seconds. Together they keep a healthy boot inside the ten-minute recovery target.
readonly LOCK_WAIT=420
readonly DOCKER_WAIT=180
readonly BRIDGE_WAIT=120
readonly SCANNER_WAIT=240
readonly PROBE_INTERVAL=5
readonly REQUEST_LIMIT=15

# The exact public-demo profile, as `docker compose config --format json` resolves it. The boot and
# the reset carry this program byte for byte, and the helper harness compares the two copies. Only
# the listed service keys may appear, so a secret, config, inherited, or device mount, an added
# capability, or a shared namespace is refused by its key. Each mount must equal its expected form
# exactly, so a volume subpath or a bind option is refused too.
readonly EXACT_PROFILE_PROGRAM='
  def declared_key: test("^(DEMO_MODE|HOST|PORT|TRUST_PROXY|WORKSPACE_INSTALL_MODE|WORKSPACE_TYPE_LIMIT|SUPER_ADMIN_(DISPLAY_NAME|PASSWORD|USERNAME)|LONGTAIL_(AUTH_[A-Z0-9_]+|CLAMD_HOST|CLAMD_PORT|DATA_DIR|DATABASE_FILE|DATABASE_PROVIDER|DEPLOYMENT_MODE|ENV|FILE_SCANNER|HSTS_MAX_AGE_SECONDS|JOB_[A-Z0-9_]+|LOCAL_STORAGE_ROOT|LOG_LEVEL|PUBLIC_URL|RELEASE_[A-Z0-9_]+|PUBLIC_DEMO_(CLIENT_REQUEST_LIMIT|GLOBAL_REQUEST_LIMIT|MAX_BODY_BYTES|MUTATION_LIMIT|PERIMETER_WINDOW_SECONDS|SEARCH_LIMIT)|SECURE_NOTES_KEY_VERSION|SECURE_NOTES_MASTER_KEY|SESSION_[A-Z0-9_]+|SQLITE_[A-Z0-9_]+|STORAGE_PROVIDER|SUPPORT_VIEW_ENABLED|SUPPORT_VIEW_TTL_SECONDS|WORKER_[A-Z0-9_]+|WORKSPACE_BACKUP_ROOT))$");
  def plain_mount:
    (if .volume == {} then del(.volume) else . end)
    | (if (.bind | type) == "object" and ((.bind | keys) - ["create_host_path"]) == [] then del(.bind) else . end);
  . as $root
  | (.services | keys) == ["longtail-forge"]
  and (.services["longtail-forge"] |
    ((keys - ["cap_drop", "command", "dns", "entrypoint", "env_file", "environment", "healthcheck", "image", "init", "logging", "networks", "ports", "read_only", "restart", "security_opt", "stop_grace_period", "tmpfs", "user", "volumes"]) == [])
    and .image == $image
    and .restart == "no"
    and .command == null
    and .entrypoint == null
    and .user == "10001:10001"
    and .read_only == true
    and .cap_drop == ["ALL"]
    and .security_opt == ["no-new-privileges:true"]
    and .dns == ["127.0.0.1"]
    and .tmpfs == ["/tmp:rw,noexec,nosuid,nodev,size=512m,mode=0700,uid=10001,gid=10001"]
    and (.networks | type == "object" and length == 1 and ((.[] // {}) == {}))
    and ((.networks | keys[0]) as $key | $root.networks[$key].name == $network and $root.networks[$key].external == true)
    and ([.volumes[] | plain_mount] | sort_by(.target) as $mounts
      | ($mounts | length) == 2
      and $mounts[0] == {type: "bind", source: $backup, target: "/var/backups/longtail-forge"}
      and ($mounts[1].source | type) == "string"
      and $mounts[1] == {type: "volume", source: $mounts[1].source, target: "/var/lib/longtail-forge"}
      and $root.volumes[$mounts[1].source] == {name: $volume})
    and (.ports | length == 1 and .[0].host_ip == "127.0.0.1" and (.[0].published | tostring) == "8001" and .[0].target == 8001)
    and .logging.driver == "local" and .logging.options["max-size"] == "10m" and .logging.options["max-file"] == "7"
    and (.environment | keys | all(declared_key))
    and (.environment |
      .DEMO_MODE == "true" and .LONGTAIL_ENV == "production" and .LONGTAIL_DEPLOYMENT_MODE == "compose"
      and .LONGTAIL_PUBLIC_URL == $origin and .LONGTAIL_DATABASE_PROVIDER == "sqlite" and .LONGTAIL_STORAGE_PROVIDER == "local"
      and .LONGTAIL_FILE_SCANNER == "clamd" and (.LONGTAIL_CLAMD_HOST | test("^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"))
      and (.LONGTAIL_CLAMD_PORT | test("^[0-9]+$")) and .LONGTAIL_WORKER_MODE == "inline" and .LONGTAIL_SUPPORT_VIEW_ENABLED == "false"
      and .LONGTAIL_DATA_DIR == "/var/lib/longtail-forge" and .LONGTAIL_DATABASE_FILE == "/var/lib/longtail-forge/longtail-forge.db"
      and .LONGTAIL_LOCAL_STORAGE_ROOT == "/var/lib/longtail-forge/files"
      and .LONGTAIL_WORKSPACE_BACKUP_ROOT == "/var/backups/longtail-forge/workspaces"))
'

fail() {
  printf 'longtail-forge-public-demo-boot: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "required command is unavailable: $1"
}

require_safe_absolute_path() {
  local target="$1" label="$2"
  [[ "$target" =~ ^/[A-Za-z0-9._/-]+$ ]] || fail "$label must be a safe absolute path"
  [[ "$target" != *'/../'* && "$target" != */.. && "$target" != *'//'* ]] || fail "$label contains unsafe traversal"
}

require_root_owned_private_file() {
  local target="$1" label="$2" parent
  test -f "$target" && test ! -L "$target" || fail "$label must be a regular non-symbolic-link file"
  test "$(stat -c '%u' "$target")" = '0' || fail "$label must be root-owned"
  test "$(stat -c '%a' "$target")" = '600' || fail "$label must use mode 0600"
  parent="$(dirname "$target")"
  test "$(stat -c '%u' "$parent")" = '0' || fail "$label parent must be root-owned"
  test $((8#$(stat -c '%a' "$parent") & 8#022)) -eq 0 || fail "$label parent must not be group- or other-writable"
}

load_helper_environment() {
  require_root_owned_private_file "$HELPER_ENV" 'compose helper environment'
  local line key
  declare -A seen=()
  while IFS= read -r line || test -n "$line"; do
    case "$line" in ''|'#'*) continue ;; esac
    key="${line%%=*}"
    [[ "$key" =~ $ALLOWED_ENV_KEYS ]] || fail "compose helper environment contains unsupported key: $key"
    test -z "${seen[$key]:-}" || fail "compose helper environment contains duplicate key: $key"
    seen[$key]=1
    export "$line"
  done < "$HELPER_ENV"
}

for command in awk curl cut date docker flock grep head install ip jq mktemp realpath stat tail timeout; do require_command "$command"; done
test "$(id -u)" = '0' || fail 'boot helper must run as root'
test "${1:-}" = 'run' && test "$#" -eq 1 || fail 'command must be exactly: run'
load_helper_environment

COMPOSE_DIR="${LTF_COMPOSE_DIR:-/opt/longtail-forge-compose}"
COMPOSE_FILE="${LTF_COMPOSE_FILE:-$COMPOSE_DIR/compose.yaml}"
COMPOSE_HOST_ENV="${LTF_COMPOSE_HOST_ENV:-/etc/longtail-forge/compose-host.env}"
DEPLOY_ROOT="${LTF_DEPLOY_ROOT:-/var/lib/longtail-forge-compose-deploy}"
STATE_ROOT="$DEPLOY_ROOT/state"
RELEASE_ROOT="$DEPLOY_ROOT/releases"
BOOT_ROOT="$DEPLOY_ROOT/demo-boot-operations"
RESET_ROOT="$DEPLOY_ROOT/demo-reset-operations"
OPERATION_LOCK="$DEPLOY_ROOT/compose-operation.lock"
BACKUP_ROOT="${LTF_BACKUP_ROOT:-/var/backups/longtail-forge/compose}"
MAINTENANCE_STATE_ROOT="${LTF_MAINTENANCE_STATE_ROOT:-/var/lib/longtail-forge-maintenance}"
DEPLOYMENT_MARKER="$MAINTENANCE_STATE_ROOT/deployment/maintenance.on"
PUBLIC_URL="${LTF_PUBLIC_URL:-}"
PUBLIC_DEMO_ISOLATION_HELPER="${LTF_PUBLIC_DEMO_ISOLATION_HELPER:-/usr/local/sbin/longtail-forge-public-demo-isolation}"
CURRENT_STATE="$STATE_ROOT/current.json"

for pair in "$COMPOSE_DIR:compose directory" "$COMPOSE_FILE:compose file" "$COMPOSE_HOST_ENV:compose host environment" \
  "$DEPLOY_ROOT:deployment root" "$BACKUP_ROOT:backup root" "$MAINTENANCE_STATE_ROOT:maintenance state root" \
  "$PUBLIC_DEMO_ISOLATION_HELPER:public-demo isolation helper"; do
  require_safe_absolute_path "${pair%%:*}" "${pair#*:}"
done
test "$PUBLIC_URL" = "$DEMO_ORIGIN" || fail 'public origin must be the exact named demo origin'
test "$BACKUP_ROOT" = '/var/backups/longtail-forge/compose' || fail 'backup root must remain the protected Compose backup directory'

install -d -o root -g root -m 0711 "$DEPLOY_ROOT"
install -d -o root -g root -m 0700 "$BOOT_ROOT"
OPERATION_ID="$(date -u +%Y%m%dT%H%M%SZ)-boot-$$"
OPERATION_DIR="$BOOT_ROOT/$OPERATION_ID"
install -d -o root -g root -m 0700 "$OPERATION_DIR"
BOOT_STARTED="$(date -u +%s)"

# Scratch space for what must never reach evidence: unredacted check output, and the resolved Compose
# configuration, which carries the application's secrets. It is removed on every exit.
WORK="$(mktemp -d /run/longtail-forge-public-demo-boot.XXXXXX)"
chmod 0700 "$WORK"
trap 'rm -rf -- "$WORK"' EXIT

# Values that must never reach evidence. Every diagnostic passes through this list before it is
# kept. It is filled when the profile resolves, before any check that could print a secret: Compose
# itself parses the application's environment files, however they are quoted, so the secrets are
# taken from the environment it resolves, with the demo role passwords and the secret-named values
# of the Compose host environment. Incomplete collection refuses the start.
: > "$WORK/redactions"
ROLE_CREDENTIALS="${LTF_DEMO_ROLE_CREDENTIALS:-/etc/longtail-forge/demo-role-credentials.json}"

# Prints each secret-named value in one environment file, parsed as Compose parses one: an optional
# `export`, a single-quoted value taken literally, a double-quoted value with its escapes, and an
# unquoted value cut at an inline comment and trimmed.
secret_values_from_env_file() {
  awk '
    {
      line = $0
      sub(/^[ \t]+/, "", line)
      if (line == "" || substr(line, 1, 1) == "#") next
      sub(/^export[ \t]+/, "", line)
      at = index(line, "=")
      if (at == 0) next
      key = substr(line, 1, at - 1)
      sub(/[ \t]+$/, "", key)
      if (key !~ /(PASSWORD|SECRET|TOKEN|KEY|CREDENTIAL)/) next
      value = substr(line, at + 1)
      sub(/^[ \t]+/, "", value)
      quote = substr(value, 1, 1)
      if (quote == "\047") {
        value = substr(value, 2)
        stop = index(value, "\047")
        if (stop > 0) value = substr(value, 1, stop - 1)
      } else if (quote == "\"") {
        out = ""
        for (i = 2; i <= length(value); i++) {
          c = substr(value, i, 1)
          if (c == "\"") break
          if (c == "\\" && i < length(value)) {
            i++
            c = substr(value, i, 1)
            if (c == "n") c = "\n"
          }
          out = out c
        }
        value = out
      } else {
        sub(/[ \t]+#.*$/, "", value)
        sub(/[ \t]+$/, "", value)
      }
      if (length(value) > 0) print value
    }' "$1"
}

# Keeps the last 64 KiB of one diagnostic file as evidence, with every listed secret replaced. Each
# value is matched as literal text, never as a pattern.
keep_redacted() {
  local source="$1" target="$2"
  if ! test -s "$source"; then
    : > "$target"
    return 0
  fi
  tail -c 65536 "$source" | awk -v listfile="$WORK/redactions" '
    BEGIN { while ((getline line < listfile) > 0) if (length(line) >= 4) secrets[++count] = line }
    {
      text = $0
      for (i = 1; i <= count; i++) {
        out = ""
        while ((at = index(text, secrets[i])) > 0) { out = out substr(text, 1, at - 1) "[redacted]"; text = substr(text, at + length(secrets[i])) }
        text = out text
      }
      print text
    }' > "$target"
}

record() {
  local phase="$1" outcome="${2:-}"
  jq -n --arg operationId "$OPERATION_ID" --arg phase "$phase" --arg outcome "$outcome" --arg target "$DEMO_TARGET" \
    --argjson elapsedSeconds "$(( $(date -u +%s) - BOOT_STARTED ))" \
    '{contract:"longtail-forge-public-demo-boot-v1",target:$target,operationId:$operationId,phase:$phase,outcome:$outcome,elapsedSeconds:$elapsedSeconds}' \
    > "$OPERATION_DIR/state.json.tmp"
  install -o root -g root -m 0600 "$OPERATION_DIR/state.json.tmp" "$OPERATION_DIR/state.json"
  rm -f -- "$OPERATION_DIR/state.json.tmp"
  jq -c . "$OPERATION_DIR/state.json" >> "$OPERATION_DIR/steps.jsonl"
}

# Raises the boot's alert, records the outcome, and stops. The demo is left as it is: stopped, or
# behind the curtain, which is the safe state for every class.
stop_with_alert() {
  local failure_class="$1" recovery_status="$2" exit_code="$3"
  record 'stopped' "$failure_class"
  local alert='failed'
  if "$ALERT_HELPER" notify --target "$DEMO_TARGET" --operation-id "$OPERATION_ID" --trigger boot \
    --scheduled-boundary none --failure-class "$failure_class" --recovery-status "$recovery_status" \
    --exit-code "$exit_code" 2>/dev/null; then
    alert='delivered'
  fi
  jq -cn --arg operationId "$OPERATION_ID" --arg failureClass "$failure_class" --arg alert "$alert" \
    '{ok:false,mode:"boot",target:"rt-ltf-demo",operationId:$operationId,failureClass:$failureClass,alertOutcome:$alert}'
  exit "$exit_code"
}

# Runs one check in a subshell with errexit in force, keeping its redacted output as evidence. It must
# not be called under `||`, `&&`, `!`, or `if`: in those positions bash ignores errexit for everything
# the check runs, even when the subshell sets it again. The outcome is left in CHECK_STATUS.
CHECK_STATUS=0
run_check() {
  local name="$1"
  shift
  set +e
  ( set -e; "$@" ) > "$WORK/check.out" 2> "$WORK/check.err"
  CHECK_STATUS=$?
  set -e
  keep_redacted "$WORK/check.out" "$OPERATION_DIR/$name.out"
  keep_redacted "$WORK/check.err" "$OPERATION_DIR/$name.err"
  rm -f -- "$WORK/check.out" "$WORK/check.err"
}

# The boot owns the curtain once it is raised. A delegated reset never lifts it, and whatever any
# reset did with the marker, the boot puts it back before it reports a failure.
ensure_curtain() {
  test -f "$DEPLOYMENT_MARKER" || install -o root -g root -m 0644 /dev/null "$DEPLOYMENT_MARKER"
}

for helper in "$RESET_HELPER" "$ALERT_HELPER" "$PUBLIC_DEMO_ISOLATION_HELPER"; do
  test -f "$helper" && test ! -L "$helper" && test -x "$helper" && test "$(stat -c '%u' "$helper")" = '0' \
    || fail "$helper must be a root-owned executable regular file"
done

record 'waiting-for-lock'
require_root_owned_private_file "$OPERATION_LOCK" 'Compose operation lock'
exec 9<>"$OPERATION_LOCK"
flock -w "$LOCK_WAIT" 9 || stop_with_alert 'lifecycle-lock-contended' 'not-started' 75

# 1. Preconditions. Each stops with its own alert, before anything starts.
record 'checking-preconditions'
if test -e "$OPERATOR_HOLD" || test -L "$OPERATOR_HOLD"; then
  stop_with_alert 'boot-held' 'demo-stopped' 3
fi
if test -e "$DEPLOYMENT_MARKER" || test -L "$DEPLOYMENT_MARKER"; then
  stop_with_alert 'boot-marker-present' 'maintenance-curtain-retained' 4
fi
release_is_recorded() {
  require_root_owned_private_file "$CURRENT_STATE" 'recorded current Compose state'
  RELEASE_ENV="$(jq -er '.deployment.releaseEnv' "$CURRENT_STATE")"
  require_safe_absolute_path "$RELEASE_ENV" 'recorded release environment'
  case "$RELEASE_ENV" in "$RELEASE_ROOT"/*.env) ;; *) return 1 ;; esac
  require_root_owned_private_file "$RELEASE_ENV" 'recorded release environment'
  IMAGE_REFERENCE="$(grep -E '^LONGTAIL_IMAGE=' "$RELEASE_ENV" | head -n 1 | cut -d= -f2-)"
  [[ "$IMAGE_REFERENCE" =~ ^ghcr\.io/[a-z0-9._/-]+@sha256:[a-f0-9]{64}$ ]] || return 1
  for field in .version .commitSha .artifact.sha256; do jq -er "$field | select(type == \"string\" and length > 0)" "$CURRENT_STATE" >/dev/null; done
}
run_check release-check release_is_recorded
test "$CHECK_STATUS" -eq 0 || stop_with_alert 'boot-release-uncertain' 'demo-stopped' 5
release_is_recorded 2>/dev/null

compose() {
  docker compose --project-directory "$COMPOSE_DIR" --file "$COMPOSE_FILE" \
    --env-file "$COMPOSE_HOST_ENV" --env-file "$RELEASE_ENV" "$@"
}

# 2. Dependencies, with bounded and recorded retries.
wait_until() {
  local label="$1" bound="$2" attempts=0 deadline
  shift 2
  deadline=$(( $(date -u +%s) + bound ))
  record "waiting-for-$label"
  while true; do
    attempts=$((attempts + 1))
    if "$@" >/dev/null 2>&1; then
      jq -cn --arg dependency "$label" --argjson attempts "$attempts" '{dependency:$dependency,attempts:$attempts,outcome:"available"}' >> "$OPERATION_DIR/dependencies.jsonl"
      return 0
    fi
    if test "$(date -u +%s)" -ge "$deadline"; then
      jq -cn --arg dependency "$label" --argjson attempts "$attempts" '{dependency:$dependency,attempts:$attempts,outcome:"unavailable"}' >> "$OPERATION_DIR/dependencies.jsonl"
      return 1
    fi
    sleep "$PROBE_INTERVAL"
  done
}
wait_until docker "$DOCKER_WAIT" docker info || stop_with_alert 'boot-dependency-unavailable' 'demo-stopped' 6

# 3. The resolved profile, read once, from Compose itself, and the secrets it carries. A parser error
# can quote a secret value from the environment files, so its output is never kept. Until this step
# completes, no kept diagnostic can hold a secret; after it, every later one is redacted.
record 'resolving-profile'
resolve_profile() {
  test -f "$COMPOSE_HOST_ENV" && test ! -L "$COMPOSE_HOST_ENV" || fail 'the Compose host environment must be a regular file'
  secret_values_from_env_file "$COMPOSE_HOST_ENV" >> "$WORK/redactions"
  compose config --format json > "$WORK/resolved.json" 2>/dev/null \
    || fail 'the resolved Compose configuration did not parse; its output is not kept because it can carry secrets'
  jq -r '.services[]?.environment // {} | to_entries[] | select(.key | test("PASSWORD|SECRET|TOKEN|KEY|CREDENTIAL")) | .value | strings' \
    "$WORK/resolved.json" >> "$WORK/redactions" 2>/dev/null || fail 'the secrets in the resolved Compose environment could not be collected'
  require_root_owned_private_file "$ROLE_CREDENTIALS" 'public-demo role credentials'
  jq -er '.passwords | objects | [.[] | strings | select(length > 0)] | if length > 0 then .[] else error("no role password") end' \
    "$ROLE_CREDENTIALS" >> "$WORK/redactions" 2>/dev/null || fail 'the public-demo role passwords could not be collected'
}
run_check profile-resolve resolve_profile
test "$CHECK_STATUS" -eq 0 || stop_with_alert 'boot-profile-invalid' 'demo-stopped' 11

# 4. Storage. Missing or uncertain storage fails closed: nothing creates a substitute database.
record 'validating-storage'
storage_is_intact() {
  local mountpoint
  mountpoint="$(docker volume inspect --format '{{.Mountpoint}}' "$DEMO_DATA_VOLUME")"
  require_safe_absolute_path "$mountpoint" 'public-demo data volume'
  test -d "$mountpoint" && test ! -L "$mountpoint"
  test -f "$mountpoint/longtail-forge.db" && test ! -L "$mountpoint/longtail-forge.db"
  test -d "$mountpoint/files" && test ! -L "$mountpoint/files"
  test "$(stat -c '%u' "$mountpoint/longtail-forge.db")" = '10001'
  test "$(stat -c '%u' "$mountpoint/files")" = '10001'
  test -s "$mountpoint/longtail-forge.db"
  test -d "$BACKUP_ROOT" && test ! -L "$BACKUP_ROOT"
  docker image inspect --format '{{.Id}}' "$IMAGE_REFERENCE" >/dev/null
}
run_check storage-check storage_is_intact
test "$CHECK_STATUS" -eq 0 || stop_with_alert 'boot-storage-failed' 'demo-stopped' 7
MOUNTPOINT="$(docker volume inspect --format '{{.Mountpoint}}' "$DEMO_DATA_VOLUME")"
if test -e "$MOUNTPOINT/.longtail-public-demo-reset-active.json"; then
  stop_with_alert 'boot-marker-present' 'demo-stopped' 4
fi

# The complete resolved profile, before anything starts: exactly the one application service with
# only the reviewed keys, the recorded image, the one isolated network, exactly the demo's data
# volume and backup bind with no subpath or option, loopback publication, and the exact production
# public-demo environment with no undeclared key. The running container is checked again by the
# isolation helper, but by then it exists; this refuses drift first.
record 'validating-profile'
profile_is_exact() {
  jq -e --arg image "$IMAGE_REFERENCE" --arg network "$DEMO_NETWORK" --arg volume "$DEMO_DATA_VOLUME" \
    --arg backup "$BACKUP_ROOT" --arg origin "$DEMO_ORIGIN" "$EXACT_PROFILE_PROGRAM" "$WORK/resolved.json" >/dev/null || {
    printf 'the resolved Compose profile is not the exact isolated public demo\n' >&2
    return 1
  }
}
run_check profile-check profile_is_exact
test "$CHECK_STATUS" -eq 0 || stop_with_alert 'boot-profile-invalid' 'demo-stopped' 11

SCANNER_HOST="$(jq -er '.services["longtail-forge"].environment.LONGTAIL_CLAMD_HOST' "$WORK/resolved.json")"
SCANNER_PORT="$(jq -er '.services["longtail-forge"].environment.LONGTAIL_CLAMD_PORT' "$WORK/resolved.json")"
NETWORK="$DEMO_NETWORK"
SQLITE_SERVICES=(longtail-forge)
bridge_has_gateway() {
  docker network inspect "$NETWORK" >/dev/null && ip -4 -o addr show dev "$DEMO_BRIDGE" | grep -Fq " $SCANNER_HOST/"
}
scanner_answers() {
  timeout 5 bash -c 'exec 3<>"/dev/tcp/$0/$1" && printf "zPING\0" >&3 && head -c 4 <&3' "$SCANNER_HOST" "$SCANNER_PORT" | grep -q '^PONG'
}
wait_until bridge "$BRIDGE_WAIT" bridge_has_gateway || stop_with_alert 'boot-dependency-unavailable' 'demo-stopped' 6
wait_until scanner "$SCANNER_WAIT" scanner_answers || stop_with_alert 'boot-dependency-unavailable' 'demo-stopped' 6

public_demo_isolation() {
  local mode="$1" container="${2:-}" arguments
  arguments=("$mode" --network "$NETWORK" --scanner-host "$SCANNER_HOST" --scanner-port "$SCANNER_PORT" --data-volume "$DEMO_DATA_VOLUME" --backup-root "$BACKUP_ROOT")
  if test -n "$container"; then arguments+=(--container "$container"); fi
  "$PUBLIC_DEMO_ISOLATION_HELPER" "${arguments[@]}" >/dev/null
}

wait_for_health() {
  local container deadline status
  container="$(compose ps -q longtail-forge)"
  test -n "$container" || return 1
  deadline=$((SECONDS + 120))
  while test "$SECONDS" -lt "$deadline"; do
    status="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}missing{{end}}' "$container")"
    test "$status" != 'unhealthy' || return 1
    test "$status" = 'healthy' && return 0
    sleep 2
  done
  return 1
}

verify_direct_identity() {
  local version commit artifact
  version="$(jq -er '.version' "$CURRENT_STATE")"
  commit="$(jq -er '.commitSha' "$CURRENT_STATE")"
  artifact="$(jq -er '.artifact.sha256' "$CURRENT_STATE")"
  wait_for_health || return 1
  public_demo_isolation check "$(compose ps -q longtail-forge)" || return 1
  curl --fail --silent --show-error --max-time "$REQUEST_LIMIT" http://127.0.0.1:8001/readyz | jq -e '.status == "ready"' >/dev/null || return 1
  curl --fail --silent --show-error --max-time "$REQUEST_LIMIT" http://127.0.0.1:8001/api/app-info | jq -e \
    --arg version "$version" --arg commit "$commit" --arg artifact "$artifact" \
    '.canonicalVersion == $version and .sourceBranch == "main" and .commitSha == $commit and .artifactSha256 == $artifact' >/dev/null
}

# 5. Start: isolation first, then the curtain, then the recorded release.
record 'enforcing-isolation'
run_check isolation public_demo_isolation enforce
test "$CHECK_STATUS" -eq 0 || stop_with_alert 'boot-start-failed' 'demo-stopped' 8
record 'curtained'
test -d "$(dirname "$DEPLOYMENT_MARKER")" && test ! -L "$(dirname "$DEPLOYMENT_MARKER")" || stop_with_alert 'boot-start-failed' 'demo-stopped' 8
install -o root -g root -m 0644 /dev/null "$DEPLOYMENT_MARKER"
start_and_verify() {
  compose up -d --no-deps --force-recreate --pull never "${SQLITE_SERVICES[@]}"
  verify_direct_identity
}
# Stops an unverified start and proves it stopped. Compose's own exit status is not taken as proof:
# only a running-state query that finds nothing is. A stop that leaves the container running is
# escalated once to a kill, and the state is queried again.
stop_unverified() {
  if compose stop --timeout 30 "${SQLITE_SERVICES[@]}" && test -z "$(compose ps --status running -q "${SQLITE_SERVICES[@]}")"; then
    return 0
  fi
  printf 'the unverified container did not stop; killing it\n' >&2
  compose kill "${SQLITE_SERVICES[@]}"
  test -z "$(compose ps --status running -q "${SQLITE_SERVICES[@]}")"
}
record 'starting'
run_check start start_and_verify
if test "$CHECK_STATUS" -ne 0; then
  # A container that failed its health, identity, or isolation proof must not keep running, even
  # behind the curtain, so whatever started is stopped again. One that cannot be stopped raises
  # its own alert, because the curtain is then all that stands between it and visitors.
  record 'stopping-unverified'
  run_check stop-unverified stop_unverified
  test "$CHECK_STATUS" -eq 0 || stop_with_alert 'boot-stop-failed' 'unverified-container-not-stopped' 12
  stop_with_alert 'boot-start-failed' 'maintenance-curtain-retained' 9
fi
record 'started'

# 6. Baseline policy: a missed hourly boundary means a fresh reset before visitors are served.
LATEST_COMPLETED=''
if test -d "$RESET_ROOT"; then
  for directory in $(find "$RESET_ROOT" -mindepth 1 -maxdepth 1 -type d -name '[0-9]*' -printf '%f\n' | sort -r); do
    if test "$(jq -r '.phase // ""' "$RESET_ROOT/$directory/state.json" 2>/dev/null)" = 'completed'; then
      LATEST_COMPLETED="${directory:0:16}"
      break
    fi
  done
fi
LAST_BOUNDARY="$(date -u +%Y%m%dT%H0000Z)"
RESET_OUTCOME='not-required'
if test -z "$LATEST_COMPLETED" || [[ "$LATEST_COMPLETED" < "$LAST_BOUNDARY" ]]; then
  record 'resetting' 'missed-boundary'
  # The reset inherits descriptor 9, this boot's hold on the lifecycle lock, so no timer run can
  # slip in between the start and the fresh baseline. It runs as the boot's delegate: it leaves the
  # curtain to the boot, even after restoring the prior unit, and verifies the direct runtime only.
  set +e
  "$RESET_HELPER" reset --target "$DEMO_TARGET" --anchor-date today --operation-id "$OPERATION_ID" \
    --caller boot --confirm "$RESET_CONFIRMATION" > "$WORK/reset.out" 2> "$WORK/reset.err"
  RESET_STATUS=$?
  set -e
  keep_redacted "$WORK/reset.out" "$OPERATION_DIR/reset.out"
  keep_redacted "$WORK/reset.err" "$OPERATION_DIR/reset.err"
  if test "$RESET_STATUS" -ne 0; then
    # A failed fresh reset never serves visitors, not even a prior unit it restored and verified.
    ensure_curtain
    if grep -Fq 'prior unit was restored and verified' "$WORK/reset.err"; then
      stop_with_alert 'boot-reset-failed' 'prior-unit-healthy-curtain-retained' 10
    fi
    stop_with_alert 'boot-reset-failed' 'maintenance-curtain-retained' 10
  fi
  RESET_OUTCOME='fresh-baseline'
fi
rm -f -- "$DEPLOYMENT_MARKER"
record 'serving' "$RESET_OUTCOME"

# 7. Public availability is reported on its own. It never causes a reset, a rollback, or a failure.
PUBLIC='unavailable'
if curl --fail --silent --max-time 10 "$PUBLIC_URL/readyz" | jq -e '.status == "ready"' >/dev/null 2>&1; then PUBLIC='available'; fi
HEARTBEAT='failed'
set +e
"$ALERT_HELPER" heartbeat --target "$DEMO_TARGET" --operation-id "$OPERATION_ID" --event boot 2>/dev/null
case "$?" in 0) HEARTBEAT='delivered' ;; 2) HEARTBEAT='not-configured' ;; esac
set -e
record 'completed' "$RESET_OUTCOME"
jq -cn --arg operationId "$OPERATION_ID" --arg baseline "$RESET_OUTCOME" --arg publicAvailability "$PUBLIC" --arg heartbeat "$HEARTBEAT" \
  --argjson elapsedSeconds "$(( $(date -u +%s) - BOOT_STARTED ))" \
  '{ok:true,mode:"boot",target:"rt-ltf-demo",operationId:$operationId,baseline:$baseline,publicAvailability:$publicAvailability,heartbeatOutcome:$heartbeat,elapsedSeconds:$elapsedSeconds}' \
  | tee "$OPERATION_DIR/result.json"
