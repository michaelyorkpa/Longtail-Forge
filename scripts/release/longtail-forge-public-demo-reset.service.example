[Unit]
Description=Longtail Forge public demo hourly reset
Documentation=https://github.com/michaelyork/longtail-forge/blob/nightly/docs/demo-data-operations.md
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/longtail-forge-public-demo-reset-scheduler run --trigger scheduled
TimeoutStartSec=30min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
