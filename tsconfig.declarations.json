{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": false,
    "types": ["node"],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
