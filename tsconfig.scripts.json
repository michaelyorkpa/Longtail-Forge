{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "scripts/**/*.mjs",
    "eslint.config.js",
    "playwright.config.js",
    "vitest.config.mjs"
  ],
  "exclude": [
    "node_modules",
    "archive",
    "data",
    "logs"
  ]
}
