{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "server.js",
    "worker.js",
    "src/**/*.js",
    "src/**/*.d.ts",
    "tests/**/*.mjs"
  ],
  "exclude": [
    "node_modules",
    "archive",
    "data",
    "logs",
    "images",
    "public",
    "styles",
    "views"
  ]
}
